// The position remains in the current bank's R4 across all comparisons.
replace {
    mov _stock_r4,a
    mov a,#%1
    xrl a,_stock_r4
    mov _ACC,a
    mov a,_ACC
    jz %2
    ljmp %3
    %2:
} by {
    mov r4,a
    xrl a,#%1
    jnz %3
}

replace {
    mov a,#%1
    xrl a,_stock_r4
    mov _ACC,a
    mov a,_ACC
    jz %2
    ljmp %3
    %2:
} by {
    mov a,r4
    xrl a,#%1
    jnz %3
}

// Swap the received nibbles in A after exchanging the old byte with B.
replace {
    mov dptr,#%1
    movx a,@dptr
    mov r7,a
    mov _ACC,_B
    mov _B,r7
    mov a,_ACC
    swap a
    mov r7,a
    mov a,_ACC
    mov a,_B
    orl a,r7
    mov _ACC,a
    mov dptr,#%1
    mov a,_ACC
    movx @dptr,a
} by {
    mov dptr,#%1
    movx a,@dptr
    xch a,_B
    swap a
    orl a,_B
    movx @dptr,a
}

replace {
    anl acc,#0xf7
} by {
    anl a,#0xf7
}

replace {
    movx @dptr,a
    ljmp %1
} by {
    movx @dptr,a
    sjmp %1
}
