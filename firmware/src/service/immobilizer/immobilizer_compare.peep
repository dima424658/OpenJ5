replace {
    mov dptr,#_immobilizer_status
    movx a,@dptr
    mov _ACC,a
    jb _ACC_BIT3,%1
    ljmp %2
    %1:
    ljmp %3
    %2:
    jnb _ACC_BIT2,%4
    ljmp %5
    %4:
    mov a,_ACC
    mov dptr,#_immobilizer_status
    anl a,#0x7f
    movx @dptr,a
    ljmp %3
    %5:
} by {
    mov dptr,#_immobilizer_status
    movx a,@dptr
    jb _ACC_BIT3,%3
    jb _ACC_BIT2,%5
    anl a,#0x7f
    movx @dptr,a
    sjmp %3
    %5:
}

// Load the first record in the active register bank.
replace {
    mov _stock_r3,#0x00
    mov dptr,#_selected_record
    movx a,@dptr
    mov _stock_r0,a
    mov dptr,#(_selected_record + 0x0001)
    movx a,@dptr
    mov _stock_r1,a
    mov dptr,#(_selected_record + 0x0002)
    movx a,@dptr
    mov _stock_r2,a
} by {
    mov r3,#0x00
    mov dptr,#_selected_record
    movx a,@dptr
    mov r0,a
    inc dptr
    movx a,@dptr
    mov r1,a
    inc dptr
    movx a,@dptr
    mov r2,a
}

// Accumulate three byte differences without changing CY.
replace {
    mov dptr,#_received_record
    movx a,@dptr
    mov r7,a
    mov a,_stock_r0
    xrl a,r7
    orl _stock_r3,a
    mov dptr,#(_received_record + 0x0001)
    movx a,@dptr
    mov r7,a
    mov a,_stock_r1
    xrl a,r7
    orl _stock_r3,a
    mov dptr,#(_received_record + 0x0002)
    movx a,@dptr
    mov r7,a
    mov a,_stock_r2
    xrl a,r7
    orl a,_stock_r3
    mov _ACC,a
    setb _EA
    mov a,_ACC
    jnz %1
    ljmp %2
    %1:
    mov dptr,#_immobilizer_status
    movx a,@dptr
    anl acc,#0x7f
    movx @dptr,a
    ljmp %3
    %2:
} by {
    mov dptr,#_received_record
    movx a,@dptr
    xrl a,r0
    orl a,r3
    mov r3,a
    inc dptr
    movx a,@dptr
    xrl a,r1
    orl a,r3
    mov r3,a
    inc dptr
    movx a,@dptr
    xrl a,r2
    orl a,r3
    setb _EA
    jz %2
    mov dptr,#_immobilizer_status
    movx a,@dptr
    anl a,#0x7f
    movx @dptr,a
    sjmp %3
    %2:
}
