// Append xdata string to serial.
replace {
    mov _DPH,_stock_r3
    mov _DPL,_stock_r4
    %1:
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    movx a,@dptr
    mov r7,a
    mov _ACC,r7
    mov a,r7
    jnz %2
    ljmp %3
    %2:
    mov r7,_DPSEL
    mov _DPSEL,#0x07
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,_ACC
    movx @dptr,a
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    inc _serial_tx_count
    mov _DPSEL,r7
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    ljmp %1
    %3:
    ret
} by {
    mov _DPH,r3
    mov _DPL,r4
    00971$:
    movx a,@dptr
    jz 00970$
    push _DPSEL
    mov _DPSEL,#0x07
    movx @dptr,a
    inc dptr
    inc _serial_tx_count
    pop _DPSEL
    inc dptr
    sjmp 00971$
    00970$:
    ret
}

