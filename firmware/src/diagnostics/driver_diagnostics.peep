// Reverse all eight bits through the stock Carry and B registers.
replace {
    mov r7,_ACC
    mov r6,#0x00
    mov r5,#0x00
    %1:
    cjne r5,#0x08,%2
    %2:
    jc %3
    ljmp %4
    %3:
    mov a,r6
    add a,acc
    mov r4,a
    mov a,#0x01
    anl a,r7
    orl a,r4
    mov r6,a
    mov a,r7
    clr c
    rrc a
    mov r7,a
    inc r5
    ljmp %1
    %4:
    mov _B,r6
    mov _ACC,_B
    %5:
    ret
} by {
    mov c,acc.0
    mov b.7,c
    mov c,acc.1
    mov b.6,c
    mov c,acc.2
    mov b.5,c
    mov c,acc.3
    mov b.4,c
    mov c,acc.4
    mov b.3,c
    mov c,acc.5
    mov b.2,c
    mov c,acc.6
    mov b.1,c
    mov c,acc.7
    mov b.0,c
    mov a,_B
    ret
}

