// Dispatch identification only within an active link.
replace {
    lcall _reset_serial_transmit_buffer
    jb _service_session_active,%1
    ljmp %2
    %1:
    setb _service_request_seen
    lcall _build_identification_response
    ljmp %3
    %2:
    mov r6,#_identification_inactive_reply
    mov r7,#(_identification_inactive_reply >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
    %3:
    setb _service_dispatch_7c
    %4:
    ret
} by {
    lcall _reset_serial_transmit_buffer
    jnb _service_session_active,00970$
    setb _service_request_seen
    lcall _build_identification_response
    sjmp 00971$
    00970$:
    mov r3,#(_identification_inactive_reply >> 8)
    mov r4,#_identification_inactive_reply
    lcall _append_code_string_to_serial
    00971$:
    setb _service_dispatch_7c
    ret
}

