// Keep the position-override action codes and the received-byte cursor.
replace {
    mov r7,_stock_r3
    mov a,r7
    jnz %1
    ljmp %2
    %1:
    cjne r7,#0x01,%3
    ljmp %4
    %3:
    cjne r7,#0x07,%5
    ljmp %6
    %5:
    ljmp %7
    %2:
    anl _idle_control_override,#0xdf
    ljmp %4
    %6:
    orl _idle_control_override,#0x20
    jb _serial_extended_length,%8
    ljmp %9
    %8:
    mov r7,#0x01
    ljmp %10
    %9:
    mov r7,#0x00
    %10:
    mov a,#0x06
    add a, r7
    add a, #_serial_rx_buffer
    mov dpl,a
    mov a,#(_serial_rx_buffer >> 8)
    addc a, #0x00
    mov dph,a
    movx a,@dptr
    mov _iac_target,a
    ljmp %4
    %7:
    mov _stock_r2,#0x12
    ljmp %11
    %4:
    mov _stock_r2,#0x00
    %11:
    ret
} by {
    mov a,r3
    xrl a,#0x00
    jnz 00970$
    anl _idle_control_override,#0xdf
    mov r2,#0x00
    sjmp 00971$
    00970$:
    mov a,r3
    xrl a,#0x01
    jnz 00972$
    mov r2,#0x00
    sjmp 00971$
    00972$:
    mov a,r3
    xrl a,#0x07
    jnz 00973$
    orl _idle_control_override,#0x20
    jnb _serial_extended_length,00974$
    mov dptr,#(_serial_rx_buffer + 7)
    movx a,@dptr
    sjmp 00975$
    00974$:
    mov dptr,#(_serial_rx_buffer + 6)
    movx a,@dptr
    00975$:
    mov _iac_target,a
    mov r2,#0x00
    sjmp 00971$
    00973$:
    mov r2,#0x12
    00971$:
    ret
}

