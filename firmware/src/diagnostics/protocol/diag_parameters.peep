// Preserve the stock parameter dispatch, including the two canned responses.
replace {
    lcall _reset_serial_transmit_buffer
    jnb _service_session_active,%1
    ljmp %2
    %1:
    mov r6,#_diag_inactive_response
    mov r7,#(_diag_inactive_response >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
    ljmp %3
    %2:
    setb _service_request_seen
    jb _serial_extended_length,%4
    ljmp %5
    %4:
    mov dptr,#(_serial_rx_buffer + 0x0005)
    movx a,@dptr
    mov r7,a
    ljmp %6
    %5:
    mov dptr,#(_serial_rx_buffer + 0x0004)
    movx a,@dptr
    mov r7,a
    %6:
    mov _stock_r4,r7
    mov r7,_stock_r4
    cjne r7,#0x01,%7
    ljmp %8
    %7:
    cjne r7,#0x02,%9
    ljmp %10
    %9:
    cjne r7,#0x03,%11
    ljmp %12
    %11:
    cjne r7,#0x04,%13
    ljmp %14
    %13:
    cjne r7,#0xa0,%15
    ljmp %16
    %15:
    cjne r7,#0xa1,%17
    ljmp %18
    %17:
    cjne r7,#0xa2,%19
    ljmp %20
    %19:
    cjne r7,#0xa3,%21
    ljmp %22
    %21:
    cjne r7,#0xe0,%23
    ljmp %24
    %23:
    ljmp %25
    %8:
    lcall _build_full_diag_response
    ljmp %3
    %10:
    lcall _build_short_diag_response
    ljmp %3
    %12:
    lcall _build_adc_diag_response
    ljmp %3
    %14:
    lcall _build_misfire_diag_response
    ljmp %3
    %16:
    lcall _build_diag_record_a0
    ljmp %3
    %18:
    lcall _build_diag_record_a1
    ljmp %3
    %20:
    lcall _build_diag_record_a2
    ljmp %3
    %22:
    lcall _build_diag_record_a3
    ljmp %3
    %24:
    lcall _build_diag_record_e0
    ljmp %3
    %25:
    mov r6,#_diag_unknown_parameter
    mov r7,#(_diag_unknown_parameter >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
    %3:
    setb _service_dispatch_7c
    %26:
    ret
} by {
    lcall _reset_serial_transmit_buffer
    jnb _service_session_active,00970$
    setb _service_request_seen
    jnb _serial_extended_length,00971$
    mov dptr,#(_serial_rx_buffer + 5)
    movx a,@dptr
    sjmp 00972$
    00971$:
    mov dptr,#(_serial_rx_buffer + 4)
    movx a,@dptr
    00972$:
    mov r4,a
    xrl a,#0x01
    jnz 00973$
    lcall _build_full_diag_response
    sjmp 00974$
    00973$:
    mov a,r4
    xrl a,#0x02
    jnz 00975$
    lcall _build_short_diag_response
    sjmp 00974$
    00975$:
    mov a,r4
    xrl a,#0x03
    jnz 00976$
    lcall _build_adc_diag_response
    sjmp 00974$
    00976$:
    mov a,r4
    xrl a,#0x04
    jnz 00977$
    lcall _build_misfire_diag_response
    sjmp 00974$
    00977$:
    mov a,r4
    xrl a,#0xa0
    jnz 00978$
    lcall _build_diag_record_a0
    sjmp 00974$
    00978$:
    mov a,r4
    xrl a,#0xa1
    jnz 00979$
    lcall _build_diag_record_a1
    sjmp 00974$
    00979$:
    mov a,r4
    xrl a,#0xa2
    jnz 00980$
    lcall _build_diag_record_a2
    sjmp 00974$
    00980$:
    mov a,r4
    xrl a,#0xa3
    jnz 00981$
    lcall _build_diag_record_a3
    sjmp 00974$
    00981$:
    mov a,r4
    xrl a,#0xe0
    jnz 00982$
    lcall _build_diag_record_e0
    sjmp 00974$
    00982$:
    mov r3,#(_diag_unknown_parameter >> 8)
    mov r4,#_diag_unknown_parameter
    lcall _append_code_string_to_serial
    sjmp 00974$
    00970$:
    mov r3,#(_diag_inactive_response >> 8)
    mov r4,#_diag_inactive_response
    lcall _append_code_string_to_serial
    00974$:
    setb _service_dispatch_7c
    ret
}

// Preserve the A0 fixed-length response.
replace {
    mov r7,_DPSEL
    mov _DPSEL,#0x07
    mov dptr,#_serial_tx_buffer
    mov a,#0x86
    movx @dptr,a
    mov dptr,#(_serial_tx_buffer + 0x0001)
    mov r0,#_serial_response_address
    mov a,@r0
    movx @dptr,a
    mov dptr,#(_serial_tx_buffer + 0x0002)
    mov a,#0x10
    movx @dptr,a
    mov dptr,#(_serial_tx_buffer + 0x0003)
    mov a,#0x61
    movx @dptr,a
    mov dptr,#(_serial_tx_buffer + 0x0004)
    mov a,_stock_r4
    movx @dptr,a
    mov _DPSEL,#0x04
    mov r5,#_serial_tx_buffer
    mov r6,#(_serial_tx_buffer >> 8)
    mov a,#0x05
    add a, r5
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, r6
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    mov _stock_r2,#0x04
    mov _DPSEL,#0x03
    mov ((_STOCK_DPTR >> 0) & 0xFF),#0x7c
    mov ((_STOCK_DPTR >> 8) & 0xFF),#0xf4
    push ar7
    lcall _copy_xdata_bytes
    pop ar7
    mov _serial_tx_count,#0x09
    mov _DPSEL,r7
    lcall _append_serial_checksum
    %1:
    ret
} by {
    push _DPSEL
    mov _DPSEL,#0x07
    mov dptr,#_serial_tx_buffer
    mov a,#0x86
    movx @dptr,a
    inc dptr
    mov r0,#_serial_response_address
    mov a,@r0
    movx @dptr,a
    inc dptr
    mov a,#0x10
    movx @dptr,a
    inc dptr
    mov a,#0x61
    movx @dptr,a
    inc dptr
    mov a,r4
    movx @dptr,a
    mov _DPSEL,#0x04
    mov dptr,#(_serial_tx_buffer + 5)
    mov r2,#0x04
    mov _DPSEL,#0x03
    mov dptr,#0xf47c
    lcall _copy_xdata_bytes
    mov _serial_tx_count,#0x09
    pop _DPSEL
    lcall _append_serial_checksum
    ret
}

