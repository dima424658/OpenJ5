// Preserve the service 3B selector and the stock register convention.
replace {
    lcall _reset_serial_transmit_buffer
    jb _service_session_active,%1
    ljmp %2
    %1:
    setb _service_request_seen
    jnb _diagnostic_write_inhibited,%3
    ljmp %2
    %3:
    jb _serial_extended_length,%4
    ljmp %5
    %4:
    mov r7,#0x01
    ljmp %6
    %5:
    mov r7,#0x00
    %6:
    mov a,#0x04
    add a, r7
    add a, #_serial_rx_buffer
    mov dpl,a
    mov a,#(_serial_rx_buffer >> 8)
    addc a, #0x00
    mov dph,a
    movx a,@dptr
    mov r7,a
    cjne r7,#0x90,%7
    sjmp %8
    %7:
    ljmp %9
    %8:
    lcall _store_identification_90
    ljmp %10
    %9:
    cjne r7,#0x98,%11
    sjmp %12
    %11:
    ljmp %13
    %12:
    lcall _store_identification_98
    ljmp %10
    %13:
    cjne r7,#0xa1,%14
    sjmp %15
    %14:
    ljmp %16
    %15:
    lcall _store_diag_record_a1
    ljmp %10
    %16:
    cjne r7,#0xa2,%17
    sjmp %18
    %17:
    ljmp %19
    %18:
    lcall _store_diag_record_a2
    ljmp %10
    %19:
    cjne r7,#0xa3,%20
    sjmp %21
    %20:
    ljmp %22
    %21:
    lcall _store_diag_record_a3
    ljmp %10
    %22:
    mov r6,#_service_3b_invalid_reply
    mov r7,#(_service_3b_invalid_reply >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
    %10:
    setb _service_dispatch_7c
    ljmp %23
    %2:
    mov r6,#_service_3b_inactive_reply
    mov r7,#(_service_3b_inactive_reply >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
    setb _service_dispatch_7c
    %23:
    ret
} by {
    lcall _reset_serial_transmit_buffer
    jnb _service_session_active,00970$
    setb _service_request_seen
    jb _diagnostic_write_inhibited,00970$
    jnb _serial_extended_length,00971$
    mov dptr,#(_serial_rx_buffer + 5)
    movx a,@dptr
    sjmp 00972$
    00971$:
    mov dptr,#(_serial_rx_buffer + 4)
    movx a,@dptr
    00972$:
    mov r4,a
    xrl a,#0x90
    jnz 00973$
    lcall _store_identification_90
    sjmp 00974$
    00973$:
    mov a,r4
    xrl a,#0x98
    jnz 00975$
    lcall _store_identification_98
    sjmp 00974$
    00975$:
    mov a,r4
    xrl a,#0xa1
    jnz 00976$
    lcall _store_diag_record_a1
    sjmp 00974$
    00976$:
    mov a,r4
    xrl a,#0xa2
    jnz 00977$
    lcall _store_diag_record_a2
    sjmp 00974$
    00977$:
    mov a,r4
    xrl a,#0xa3
    jnz 00978$
    lcall _store_diag_record_a3
    sjmp 00974$
    00978$:
    mov r3,#(_service_3b_invalid_reply >> 8)
    mov r4,#_service_3b_invalid_reply
    lcall _append_code_string_to_serial
    sjmp 00974$
    00970$:
    mov r3,#(_service_3b_inactive_reply >> 8)
    mov r4,#_service_3b_inactive_reply
    lcall _append_code_string_to_serial
    00974$:
    setb _service_dispatch_7c
    ret
}
