    nop
    nop
    mov _stock_r0,_mdu_0
    mov _stock_r1,_mdu_1
    mov _stock_r2,_mdu_2
    mov a,_mdu_3
    mov a,_mdu_4
    mov a,_mdu_5
} by {
    mov _mdu_0,#0x0e
    mov _mdu_1,#0xe8
    mov _mdu_2,#0xf5
    mov _mdu_3,#0xce
    mov _mdu_4,r6
    mov _mdu_5,r7
    nop
    nop
    nop
    nop
    nop
    nop
    mov r0,_mdu_0
    mov r1,_mdu_1
    mov r2,_mdu_2
    mov a,_mdu_3
    mov a,_mdu_4
    mov a,_mdu_5
}

