    mov r2,_charge_q4
    lcall _interp_curve_q4
    sjmp 00972$
    00970$:
    mov dptr,#_roughness_map_flags
    movx a,@dptr
    mov dptr,#_roughness_limit_3
    jnb acc.0,00971$
    mov dptr,#_roughness_alt_limit_3
    00971$:
    mov r2,_rpm_index_q4
    mov r3,_charge_q4
    lcall _interp_bilinear_u8
    00972$:
