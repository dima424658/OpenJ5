// Dispatch on sensor faults before touching the running counter.
replace {
    mov c,_throttle_adc_low
    clr a
    rlc a
    mov r7,a
    mov c,_throttle_adc_high
    clr a
    rlc a
    mov r6,a
    mov a,r6
    orl ar7,a
    mov c,_maf_adc_low
    clr a
    rlc a
    mov r6,a
    mov a,r6
    orl ar7,a
    mov c,_maf_adc_high
    clr a
    rlc a
    mov r6,a
    mov a,r6
    orl ar7,a
    mov a,r7
    add a,#0xff
    mov _CY,c
    jnb _CY,%1
    ljmp %2
    %1:
    jb _tick_1s,%3
    ljmp %4
    %3:
    mov dptr,#_air_charge_elapsed
    movx a,@dptr
    mov r7,a
    mov a,r7
    inc a
    mov _ACC,a
    mov a,_ACC
    jnz %5
    ljmp %4
    %5:
    mov dptr,#_air_charge_elapsed
    mov a,_ACC
    movx @dptr,a
    %4:
} by {
    mov c,_throttle_adc_low
    orl c,_throttle_adc_high
    orl c,_maf_adc_low
    orl c,_maf_adc_high
    jc %2
    jnb _tick_1s,%4
    mov dptr,#_air_charge_elapsed
    movx a,@dptr
    add a,#0x01
    jc %4
    movx @dptr,a
    %4:
}

// Interpolate the base map, then read the zone at the rounded grid point.
replace {
    mov _stock_r2,_rpm_index_q4
    mov a,_throttle_position
    add a,#_throttle_quantization_q4
    mov dpl,a
    mov a,#0x00
    addc a,#(_throttle_quantization_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r3,a
    mov r6,#_base_cylinder_charge_raw
    mov r7,#(_base_cylinder_charge_raw >> 8)
    mov ((_STOCK_DPTR >> 0) & 0xFF),r6
    mov ((_STOCK_DPTR >> 8) & 0xFF),r7
    lcall _interp_bilinear_u8
    mov _stock_r3,_ACC
    mov a,_throttle_position
    add a,#_throttle_quantization_q4
    mov dpl,a
    mov a,#0x00
    addc a,#(_throttle_quantization_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r4,a
    mov r7,_stock_r4
    mov a,#0x08
    add a,r7
    mov r7,a
    anl ar7,#0xf0
    mov r6,_rpm_nearest_bin
    mov a,r6
    add a,r7
    mov _stock_r2,a
    mov a,_stock_r2
    add a,#_barometric_correction_zone
    mov dpl,a
    mov a,#0x00
    addc a,#(_barometric_correction_zone >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov _ACC,r7
    mov a,_ACC
    jnz %1
    ljmp %2
    %1:
    jb _ACC_SIGN,%3
    ljmp %4
    %3:
    lcall _check_barometric_neighbors
    ljmp %5
    %4:
    clr _full_barometric_correction
    lcall _learn_barometric_correction
    ljmp %5
    %2:
    clr _full_barometric_correction
    lcall _use_uncorrected_air_charge
    %5:
    ret
} by {
    mov r2,_rpm_index_q4
    mov dptr,#_throttle_quantization_q4
    mov a,_throttle_position
    movc a,@a+dptr
    mov r3,a
    mov dptr,#_base_cylinder_charge_raw
    lcall _interp_bilinear_u8
    mov r3,a
    mov dptr,#_throttle_quantization_q4
    mov a,_throttle_position
    movc a,@a+dptr
    mov r4,a
    add a,#0x08
    anl a,#0xf0
    add a,_rpm_nearest_bin
    mov r2,a
    mov dptr,#_barometric_correction_zone
    mov a,r2
    movc a,@a+dptr
    jnz %1
    %2:
    clr _full_barometric_correction
    ljmp _use_uncorrected_air_charge
    %1:
    jb _ACC_SIGN,%5
    clr _full_barometric_correction
    ljmp _learn_barometric_correction
    %5:
}

// Initialize the reverse-flow branch and test the preceding throttle row.
replace {
    mov dptr,#_barometric_state_f82a
    mov a,#0x00
    movx @dptr,a
    mov dptr,#_barometric_filter_length
    movc a,@a+dptr
    mov r7,a
    mov a,r7
    clr c
    rrc a
    mov r7,a
    mov dptr,#_barometric_half_window
    mov a,r7
    movx @dptr,a
    mov dptr,#_barometric_state_f897
    mov a,#0x00
    movx @dptr,a
    mov _B,#0x07
    clr c
    mov a,_stock_r2
    subb a,#0x10
    jnc %1
    ljmp %2
    %1:
    mov r6,_stock_r2
    mov r7,#0x00
    mov a,r6
    add a,#0xf0
    mov r6,a
    mov a,r7
    addc a,#0xff
    mov r7,a
    mov a,r6
    add a,#_barometric_correction_zone
    mov dpl,a
    mov a,r7
    addc a,#(_barometric_correction_zone >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov _ACC,r7
    jnb _ACC_SIGN,%3
    ljmp %2
    %3:
    clr _B_BIT0
    %2:
} by {
    clr a
    mov dptr,#_barometric_state_f82a
    movx @dptr,a
    mov dptr,#_barometric_filter_length
    clr a
    movc a,@a+dptr
    clr c
    rrc a
    mov dptr,#_barometric_half_window
    movx @dptr,a
    clr a
    mov dptr,#_barometric_state_f897
    movx @dptr,a
    mov _B,#0x07
    mov a,r2
    clr c
    subb a,#0x10
    jc %2
    mov dptr,#_barometric_correction_zone
    movc a,@a+dptr
    jb _ACC_SIGN,%2
    clr _B_BIT0
    %2:
}

// Check the next RPM column using the nibble carry for the right edge.
replace {
    mov r7,_stock_r2
    anl ar7,#0x0f
    cjne r7,#0x0f,%1
    %1:
    jc %2
    ljmp %3
    %2:
    mov r6,_stock_r2
    mov r7,#0x00
    inc r6
    cjne r6,#0x00,%4
    inc r7
    %4:
    mov a,r6
    add a,#_barometric_correction_zone
    mov dpl,a
    mov a,r7
    addc a,#(_barometric_correction_zone >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov _ACC,r7
    jnb _ACC_SIGN,%5
    ljmp %3
    %5:
    clr _B_BIT1
    %3:
} by {
    mov a,r2
    swap a
    add a,#0x10
    jc %3
    swap a
    mov dptr,#_barometric_correction_zone
    movc a,@a+dptr
    jb _ACC_SIGN,%3
    clr _B_BIT1
    %3:
}

// Retest the next column in the interior, and use the mask at the edges.
// The final short branch reaches 38E6 across the separate weight block.
replace {
    clr c
    mov a,_stock_r2
    subb a,#0x10
    jnc %1
    ljmp %2
    %1:
    mov r7,_stock_r2
    anl ar7,#0x0f
    cjne r7,#0x0f,%3
    %3:
    jc %4
    ljmp %2
    %4:
    mov r6,_stock_r2
    mov r7,#0x00
    inc r6
    cjne r6,#0x00,%5
    inc r7
    %5:
    mov a,r6
    add a,#_barometric_correction_zone
    mov dpl,a
    mov a,r7
    addc a,#(_barometric_correction_zone >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov _ACC,r7
    jnb _ACC_SIGN,%6
    ljmp %7
    %6:
    ljmp %8
    %2:
    mov a,#0x07
    cjne a,_B,%9
    sjmp %10
    %9:
    ljmp %8
    %10:
    %7:
    setb _full_barometric_correction
    mov _stock_r4,#0xff
    lcall _apply_reverse_flow_correction
    ljmp %11
    %8:
    lcall _select_partial_baro_weight
    %11:
    ret
} by {
    mov a,r2
    clr c
    subb a,#0x10
    jc %2
    mov a,r2
    swap a
    add a,#0x10
    jc %2
    swap a
    mov dptr,#_barometric_correction_zone
    movc a,@a+dptr
    jb _ACC_SIGN,%7
    sjmp %8
    %2:
    mov a,_B
    cjne a,#0x07,%8
    %7:
    setb _full_barometric_correction
    mov r4,#0xff
    sjmp .+0x2b
    %8:
}
