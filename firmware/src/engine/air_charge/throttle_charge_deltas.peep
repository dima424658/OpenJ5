    movx a,@dptr
    mov r3,a
    lcall _subtract_u16_register_pairs
    jc 00956$
    mov dptr,#_closing_fuel_candidate
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    sjmp 00957$
    00956$:
    mov dptr,#_closing_fuel_delta
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    mov dptr,#_closing_fuel_decay_2
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    00957$:
    mov dptr,#_closing_fuel_delta
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    mov dptr,#_opening_fuel_delta
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
