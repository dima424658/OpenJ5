    mov dptr,#_closing_fuel_delta
    movx a,@dptr
    mov _stock_r01,a
    inc dptr
    movx a,@dptr
    mov (_stock_r01 + 1),a
    mov dptr,#_closing_fuel_decay_2
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_closing_fuel_delta
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    mov dptr,#_closing_fuel_candidate
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    lcall _finish_throttle_charge_update
    %1:
    ret
} by {
    mov dptr,#_closing_fuel_delta
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    mov dptr,#_closing_fuel_decay_2
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_closing_fuel_delta
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    mov dptr,#_closing_fuel_candidate
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    sjmp _finish_throttle_charge_update
}

// Clear the correction words and continue in place.
replace {
    mov dptr,#_opening_fuel_delta
    mov a,#0x00
    movx @dptr,a
    inc dptr
    movx @dptr,a
    mov dptr,#_opening_fuel_candidate
    movx @dptr,a
    inc dptr
    movx @dptr,a
    mov dptr,#_closing_fuel_delta
    movx @dptr,a
    inc dptr
    movx @dptr,a
    mov dptr,#_closing_fuel_candidate
    movx @dptr,a
    inc dptr
    movx @dptr,a
    lcall _finish_throttle_charge_update
    %1:
    ret
} by {
    clr a
    mov dptr,#_opening_fuel_delta
    movx @dptr,a
    mov dptr,#(_opening_fuel_delta + 1)
    movx @dptr,a
    mov dptr,#_opening_fuel_candidate
    movx @dptr,a
    mov dptr,#(_opening_fuel_candidate + 1)
    movx @dptr,a
    mov dptr,#_closing_fuel_delta
    movx @dptr,a
    mov dptr,#(_closing_fuel_delta + 1)
    movx @dptr,a
    mov dptr,#_closing_fuel_candidate
    movx @dptr,a
    mov dptr,#(_closing_fuel_candidate + 1)
    movx @dptr,a
}
