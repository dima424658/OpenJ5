    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    mov dptr,#_opening_fuel_decay_2
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
}

// Write the opening estimate and fall through to closing decay.
replace {
    mov dptr,#_opening_fuel_delta
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    lcall _decay_closing_charge_delta
    %1:
    ret
} by {
    mov dptr,#_opening_fuel_delta
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
}

// Decay the closing estimate and publish it to both closing words.
