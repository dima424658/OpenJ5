    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    mov dptr,#_opening_fuel_delta
    movx a,@dptr
    mov r2,a
    inc dpl
    movx a,@dptr
    mov r3,a
