// Accept a mapped charge increase or take the idle-event decay path.
replace {
    jnb _output_state_flag_45,%1
    ljmp %2
    %1:
    mov _B,_ACC
    mov dptr,#_opening_throttle_deadband
    clr a
    movc a,@a+dptr
    mov r7,a
    clr c
    mov a,r7
    subb a,_B
    jc %3
    ljmp %4
    %3:
    mov dptr,#_previous_mapped_charge
    movx a,@dptr
    mov _B,a
    mov a,_stock_r2
    movx @dptr,a
    clr c
    mov a,_B
    subb a,_stock_r2
    jc %5
    ljmp %2
    %5:
    mov a,_stock_r2
    clr c
    subb a,_B
    mov _B,a
    mov dptr,#_charge_opening_increment
    mov a,_B
    movx @dptr,a
    mov a,_coolant_nearest_index
    add a, #_opening_charge_gain
    mov dpl,a
    mov a,#0x00
    addc a, #(_opening_charge_gain >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov r6,_B
    mov b,r7
    mov a,r6
    mul ab
    mov r7,a
    mov r5,b
    mov _stock_r01,r7
    mov (_stock_r01 + 1),r5
    lcall _shift_right_u16_2
    lcall _store_opening_charge_delta
    ljmp %6
    %4:
    mov dptr,#_previous_mapped_charge
    mov a,_stock_r2
    movx @dptr,a
    %2:
    mov a,_crank_state_41
    jz %7
    ljmp %8
    %7:
    mov dptr,#_opening_fuel_delta
    movx a,@dptr
    mov _stock_r01,a
    inc dptr
    movx a,@dptr
    mov (_stock_r01 + 1),a
    mov dptr,#_opening_fuel_decay_1
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    lcall _write_opening_charge_delta
    ljmp %6
    %8:
    lcall _decay_closing_charge_delta
    %6:
    ret
} by {
    jb _output_state_flag_45,00958$
    mov _B,a
    mov dptr,#_opening_throttle_deadband
    clr a
    movc a,@a+dptr
    cjne a,_B,00959$
    00959$:
    jnc 00960$
    mov _B,r2
    mov dptr,#_previous_mapped_charge
    movx a,@dptr
    xch a,_B
    mov dptr,#_previous_mapped_charge
    movx @dptr,a
    clr c
    subb a,_B
    jz 00958$
    jc 00958$
    mov _B,a
    mov dptr,#_charge_opening_increment
    movx @dptr,a
    mov dptr,#_opening_charge_gain
    mov a,_coolant_nearest_index
    movc a,@a+dptr
    mul ab
    mov r0,a
    mov r1,_B
    lcall _shift_right_u16_2
    sjmp _store_opening_charge_delta
    00960$:
    mov a,r2
    mov dptr,#_previous_mapped_charge
    movx @dptr,a
    00958$:
    mov a,_crank_state_41
    jnz _decay_closing_charge_delta
    mov dptr,#_opening_fuel_delta
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    mov dptr,#_opening_fuel_decay_1
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    sjmp _write_opening_charge_delta
}

