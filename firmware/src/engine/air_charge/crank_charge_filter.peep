// Keep the sample-batch gate and the separately calibrated turbo correction path.
replace {
    jnb _sensor_batch_ready,%1
    ljmp %2
    %1:
    lcall _apply_cylinder_charge_limit
    ljmp %3
    %2:
    mov dptr,#_turbo_charge_filter_gain
    clr a
    movc a,@a+dptr
    jnz %4
    ljmp %5
    %4:
    mov _B,_rpm_eighth
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_4
    mov dptr,#_turbo_charge_history
    movx a,@dptr
    mov _stock_r23,a
    inc dptr
    movx a,@dptr
    mov (_stock_r23 + 1),a
    mov dptr,#_turbo_charge_history
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    lcall _subtract_u16_register_pairs
    mov dptr,#_turbo_charge_filter_gain
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_i16_u8
    mov dptr,#_airflow_period_charge
    movx a,@dptr
    mov _stock_r23,a
    inc dptr
    movx a,@dptr
    mov (_stock_r23 + 1),a
    lcall _add_u16_register_pairs
    mov dptr,#_airflow_period_charge
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    %5:
    lcall _filter_measured_air_charge
    %3:
    ret
} by {
    jb _sensor_batch_ready,00950$
    ljmp _apply_cylinder_charge_limit
    00950$:
    mov dptr,#_turbo_charge_filter_gain
    clr a
    movc a,@a+dptr
    jz _filter_measured_air_charge
    mov _B,_rpm_eighth
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_4
    mov dptr,#_turbo_charge_history
    movx a,@dptr
    mov r2,a
    inc dpl
    movx a,@dptr
    mov r3,a
    mov dptr,#_turbo_charge_history
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    lcall _subtract_u16_register_pairs
    mov dptr,#_turbo_charge_filter_gain
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_i16_u8
    mov dptr,#_airflow_period_charge
    movx a,@dptr
    mov r2,a
    inc dpl
    movx a,@dptr
    mov r3,a
    lcall _add_u16_register_pairs
    mov dptr,#_airflow_period_charge
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
}

// Use the full barometric value or smooth the signed charge delta with the selected gain.
replace {
    jb _full_barometric_correction,%1
    ljmp %2
    %1:
    mov dptr,#_air_charge_limit
    movx a,@dptr
    mov _stock_r01,a
    inc dptr
    movx a,@dptr
    mov (_stock_r01 + 1),a
    ljmp %3
    %2:
    mov dptr,#_measured_air_charge
    movx a,@dptr
    mov _stock_r23,a
    inc dptr
    movx a,@dptr
    mov (_stock_r23 + 1),a
    lcall _subtract_u16_register_pairs
    jb _idle_mode,%4
    ljmp %5
    %4:
    mov dptr,#_idle_charge_filter_gain
    clr a
    movc a,@a+dptr
    mov r7,a
    ljmp %6
    %5:
    mov dptr,#_charge_filter_coefficient
    movx a,@dptr
    mov r7,a
    %6:
    mov _B,r7
    lcall _multiply_stock_i16_u8
    mov dptr,#_measured_air_charge
    movx a,@dptr
    mov _stock_r23,a
    inc dptr
    movx a,@dptr
    mov (_stock_r23 + 1),a
    lcall _add_u16_register_pairs
    %3:
    lcall _apply_cylinder_charge_limit
    %7:
    ret
} by {
    jnb _full_barometric_correction,00951$
    mov dptr,#_air_charge_limit
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    sjmp _apply_cylinder_charge_limit
    00951$:
    mov dptr,#_measured_air_charge
    movx a,@dptr
    mov r2,a
    inc dpl
    movx a,@dptr
    mov r3,a
    lcall _subtract_u16_register_pairs
    jb _idle_mode,00952$
    mov dptr,#_charge_filter_coefficient
    movx a,@dptr
    mov _B,a
    sjmp 00953$
    00952$:
    mov dptr,#_idle_charge_filter_gain
    clr a
    movc a,@a+dptr
    mov _B,a
    00953$:
    lcall _multiply_stock_i16_u8
    mov dptr,#_measured_air_charge
    movx a,@dptr
    mov r2,a
    inc dpl
    movx a,@dptr
    mov r3,a
    lcall _add_u16_register_pairs
}

// Store the measured charge and use the fixed limit or bound the interpolation input.
replace {
    mov dptr,#_measured_air_charge
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    mov dptr,#_air_charge_limit
    movx a,@dptr
    mov _stock_r23,a
    inc dptr
    movx a,@dptr
    mov (_stock_r23 + 1),a
    mov a,#0xff
    cjne a,_stock_r23,%1
    cjne a,(_stock_r23 + 1),%1
    ljmp %2
    %1:
    mov _stock_r01,_bank_one_r23
    mov (_stock_r01 + 1),(_bank_one_r23 + 1)
    lcall _process_cylinder_charge
    ljmp %3
    %2:
    mov dptr,#_measured_air_charge
    movx a,@dptr
    mov _stock_r01,a
    inc dptr
    movx a,@dptr
    mov (_stock_r01 + 1),a
    mov dptr,#(_maximum_cylinder_charge + 0x0001)
    clr a
    movc a,@a+dptr
    mov _stock_r3,a
    mov dptr,#_maximum_cylinder_charge
    clr a
    movc a,@a+dptr
    mov _stock_r2,a
    lcall _minimum_u16_register_pair
} by {
    mov dptr,#_measured_air_charge
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    mov dptr,#_air_charge_limit
    movx a,@dptr
    mov r2,a
    inc dpl
    movx a,@dptr
    mov r3,a
    mov a,r2
    anl a,r3
    cjne a,#0xff,00954$
    mov dptr,#_measured_air_charge
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    mov dptr,#(_maximum_cylinder_charge + 1)
    clr a
    movc a,@a+dptr
    mov r3,a
    mov dptr,#_maximum_cylinder_charge
    clr a
    movc a,@a+dptr
    mov r2,a
    lcall _minimum_u16_register_pair
    sjmp 00955$
    00954$:
    mov r0,_bank_one_r23
    mov r1,(_bank_one_r23 + 1)
    sjmp _process_cylinder_charge
}

// Apply the correction map with stock truncation and saturation, then continue in place.
replace {
    mov dptr,#_bounded_air_charge
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    mov a,_throttle_position
    add a, #_throttle_quantization_q4
    mov dpl,a
    mov a,#0x00
    addc a, #(_throttle_quantization_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r3,a
    mov r6,#_cylinder_charge_correction
    mov r7,#(_cylinder_charge_correction >> 8)
    mov ((_STOCK_DPTR >> 0) & 0xFF),r6
    mov ((_STOCK_DPTR >> 8) & 0xFF),r7
    mov _stock_r2,_rpm_q4
    lcall _interp_bilinear_u8
    mov _B,_ACC
    mov dptr,#_bounded_air_charge
    movx a,@dptr
    mov _stock_r01,a
    inc dptr
    movx a,@dptr
    mov (_stock_r01 + 1),a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
    lcall _process_cylinder_charge
    %1:
    ret
} by {
    00955$:
    mov dptr,#_bounded_air_charge
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    mov dptr,#_throttle_quantization_q4
    mov a,_throttle_position
    movc a,@a+dptr
    mov r3,a
    mov dptr,#_cylinder_charge_correction
    mov r2,_rpm_q4
    lcall _interp_bilinear_u8
    mov _B,a
    mov dptr,#_bounded_air_charge
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
}
