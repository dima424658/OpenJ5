// Compare the asynchronously updated position with the target already in A.
replace {
    %1:
    setb _iac_tick_interrupt_enabled
    setb _iac_tick_high_priority
    mov _ACC,_iac_target
    mov a,_iac_position
    cjne a,_ACC,%2
    sjmp %3
    %2:
    ljmp %1
    %3:
} by {
    %1:
    setb _iac_tick_interrupt_enabled
    setb _iac_tick_high_priority
    mov a,_iac_target
    cjne a,_iac_position,%1
}

replace {
    mov dptr,#_startup_coolant_temperature_raw
    mov a,_coolant_temperature_raw
    movx @dptr,a
} by {
    mov a,_coolant_temperature_raw
    mov dptr,#_startup_coolant_temperature_raw
    movx @dptr,a
}

replace {
    mov dptr,#_cold_start_coolant_threshold
    clr a
    movc a,@a+dptr
    mov r7,a
    clr c
    mov a,r7
    subb a,_coolant_temperature_raw
    jnc %1
    ljmp %2
    %1:
    mov dptr,#_cold_start_iac_max_position
    clr a
    movc a,@a+dptr
    mov _ACC,a
    ljmp %3
    %2:
    mov dptr,#_iac_max_position
    clr a
    movc a,@a+dptr
    mov _ACC,a
    %3:
    mov _iac_target,_ACC
} by {
    mov dptr,#_cold_start_coolant_threshold
    clr a
    movc a,@a+dptr
    cjne a,_coolant_temperature_raw,%1
    %1:
    jc %2
    mov dptr,#_cold_start_iac_max_position
    clr a
    movc a,@a+dptr
    sjmp %3
    %2:
    mov dptr,#_iac_max_position
    clr a
    movc a,@a+dptr
    %3:
    mov _iac_target,a
}

replace {
    lcall _home_iac_at_startup
    lcall _seed_startup_iac_feedback
    %1:
    ret
} by {
    lcall _home_iac_at_startup
    sjmp _seed_startup_iac_feedback
}

replace {
    mov _iac_position,a
    lcall _seed_startup_iac_feedback
    %1:
    ret
} by {
    mov _iac_position,a
}

// The next startup block is an entry in the same original routine.
replace {
    mov _stock_r01,_iac_target
    mov (_stock_r01 + 1),#0x00
    lcall _shift_left_saturating_4
    mov dptr,#_iac_feedback_position_q4
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    mov dptr,#_startup_iac_state_marker
    mov a,#0x55
    movx @dptr,a
    lcall _continue_startup_after_iac
    %1:
    ret
} by {
    mov a,_iac_target
    mov r0,a
    mov r1,#0x00
    lcall _shift_left_saturating_4
    mov dptr,#_iac_feedback_position_q4
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    mov a,#0x55
    mov dptr,#_startup_iac_state_marker
    movx @dptr,a
}
