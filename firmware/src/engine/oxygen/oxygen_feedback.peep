// Initialize the feedback state or branch into the running regulator.
replace {
    jb _fuel_mode_flag_5c,%1
    ljmp %2
    %1:
    lcall _track_oxygen_feedback
    ljmp %3
    %2:
    mov dptr,#_oxygen_reference_rpm
    mov a,_rpm_half_bin
    movx @dptr,a
    mov dptr,#_oxygen_reference_charge
    mov a,_charge_half_bin
    movx @dptr,a
    jb _oxygen_signal_rich,%4
    ljmp %5
    %4:
    mov r7,#0xff
    ljmp %6
    %5:
    mov r7,#0x00
    %6:
    mov _oxygen_transition_bits,r7
    mov dptr,#_oxygen_center_ticks
    mov a,#0x00
    movx @dptr,a
    mov dptr,#_oxygen_stable_ticks
    movx @dptr,a
    mov dptr,#_oxygen_transition_delay
    movx @dptr,a
    mov _oxygen_control_adjustment,a
    setb _fuel_mode_flag_5c
    %3:
    ret
} by {
    jb _fuel_mode_flag_5c,_track_oxygen_feedback
    mov a,_rpm_half_bin
    mov dptr,#_oxygen_reference_rpm
    movx @dptr,a
    mov a,_charge_half_bin
    mov dptr,#_oxygen_reference_charge
    movx @dptr,a
    jnb _oxygen_signal_rich,00970$
    mov _oxygen_transition_bits,#0xff
    sjmp 00971$
    00970$:
    mov _oxygen_transition_bits,#0x00
    00971$:
    clr a
    mov dptr,#_oxygen_center_ticks
    movx @dptr,a
    mov dptr,#_oxygen_stable_ticks
    movx @dptr,a
    mov dptr,#_oxygen_transition_delay
    movx @dptr,a
    mov _oxygen_control_adjustment,#0x00
    setb _fuel_mode_flag_5c
    ret
}

