    movx @dptr,a
    mov a,_knock_window_override
    jnb acc.7,%5
    ljmp %6
    %5:
    mov a,_stock_r1
    add a, #_cylinder_retard
    mov r0,acc
    mov @r0,_stock_r3
    %6:
    inc _stock_r1
    ljmp %7
    %8:
    ret
} by {
    00954$:
