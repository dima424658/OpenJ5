}

// Compare with physical IRAM and age the zone hold counter.
replace {
    clr c
    mov a,_stock_r4
    subb a,_bank_zero_r3
    jnc %1
    ljmp %2
    %1:
    mov _stock_r3,_stock_r4
    ljmp %3
    %2:
    mov a,_stock_r1
    add a, #_zone_hold_count
    mov dpl,a
    mov a,#0x00
    addc a, #(_zone_hold_count >> 8)
    mov dph,a
    movx a,@dptr
    mov r6,a
    dec r6
    mov a,_stock_r1
    add a, #_zone_hold_count
    mov dpl,a
    mov a,#0x00
    addc a, #(_zone_hold_count >> 8)
    mov dph,a
    mov a,r6
    movx @dptr,a
    mov a,r6
    jz %4
    ljmp %3
    %4:
    dec _stock_r3
    mov a,_stock_r1
    add a, #_zone_hold_count
    mov dpl,a
    mov a,#0x00
    addc a, #(_zone_hold_count >> 8)
    mov dph,a
    mov a,#0x05
    movx @dptr,a
    %3:
} by {
    00948$:
    mov a,r4
    cjne a,_bank_zero_r3,00952$
    00952$:
    jc 00953$
    mov r3,a
    sjmp 00954$
    00953$:
    mov dptr,#_zone_hold_count
    mov a,dpl
    add a,r1
    mov dpl,a
    movx a,@dptr
    dec a
    movx @dptr,a
    jnz 00954$
    dec r3
    mov a,#0x05
    movx @dptr,a
}

// Clamp the two retard values, store the zone and advance the stock cylinder loop.
