    cjne r7,#0x04,%16
    %16:
    jc %17
    ljmp %18
    %17:
    mov a,r7
    add a, #_cylinder_retard
    mov r1,a
    mov a,_rpm_half_step_index
    add a, #_knock_maximum_retard_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_knock_maximum_retard_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r6,a
    mov @r1,ar6
    inc r7
    ljmp %15
    %18:
    ljmp %19
    %14:
} by {
    jb _previous_fuel_mode_63,00940$
    mov _previous_knock_mask,#0x00
    mov _B,#0x04
    mov dptr,#_cylinder_knock_interval
    clr a
    00941$:
    movx @dptr,a
    inc dptr
    djnz _B,00941$
