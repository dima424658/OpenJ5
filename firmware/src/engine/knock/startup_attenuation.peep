// Cases 0, 1, 2 and 3 map to the stock gain constants 1, 2, 4 and 4.
replace {
    mov a,_noise_attenuator_state
    swap a
    rl a
    anl a,#0x1f
    mov r7,a
    mov a,#0x03
    anl a,r7
    mov _ACC,a
    mov a,#0x01
    cjne a,_ACC,%1
    sjmp %2
    %1:
    ljmp %3
    %2:
    mov _ACC,#0x02
    ljmp %4
    %3:
    clr c
    mov a,_ACC
    subb a,#0x01
    jc %5
    ljmp %6
    %5:
    mov _ACC,#0x01
    ljmp %4
    %6:
    mov _ACC,#0x04
    %4:
    mov _B,_ACC
} by {
    mov a,_noise_attenuator_state
    rr a
    rr a
    rr a
    anl a,#0x03
    cjne a,#0x01,%3
    mov a,#0x02
    sjmp %4
    %3:
    jnc %6
    mov a,#0x01
    sjmp %4
    %6:
    mov a,#0x04
    %4:
    mov _B,a
}

// A nonzero high byte means the scaled noise exceeds 255.
replace {
    mov dptr,#_retained_knock_noise
    movx a,@dptr
    mov r7,a
    mov r6,_B
    mov b,r7
    mov a,r6
    mul ab
    mov r7,a
    mov r5,b
    mov ar4,r7
    mov ar6,r5
    clr c
    mov a,#0xff
    subb a,r4
    mov a,#0x00
    subb a,r6
    jc %1
    ljmp %2
    %1:
    mov r6,#0xff
    ljmp %3
    %2:
    mov ar6,r7
    %3:
    mov _stock_r0,r6
    mov _ACC,_stock_r0
} by {
    mov dptr,#_retained_knock_noise
    movx a,@dptr
    mul ab
    mov r0,a
    mov a,_B
    jz %3
    mov r0,#0xff
    %3:
    mov a,r0
}

// Keep the noise-derived index in ACC for indexed CODE reads.
replace {
    mov dptr,#_scaled_knock_noise
    mov a,_ACC
    movx @dptr,a
    mov a,_ACC
    swap a
    rl a
    anl a,#0x1f
    mov _ACC,a
    mov dptr,#_knock_noise_index
    mov a,_ACC
    movx @dptr,a
    mov a,_ACC
    add a,#_knock_relative_threshold_q4
    mov dpl,a
    mov a,#0x00
    addc a,#(_knock_relative_threshold_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
} by {
    mov dptr,#_scaled_knock_noise
    movx @dptr,a
    swap a
    rl a
    anl a,#0x1f
    mov dptr,#_knock_noise_index
    movx @dptr,a
    mov dptr,#_knock_relative_threshold_q4
    movc a,@a+dptr
    mov _B,a
}

// Test the high nibble of the 16-bit product before extracting bits 4..11.
replace {
    mov dptr,#_retained_knock_noise
    movx a,@dptr
    mov r7,a
    mov r6,_B
    mov b,r7
    mov a,r6
    mul ab
    mov r7,a
    mov r5,b
    mov a,r5
    swap a
    xch a,r7
    swap a
    anl a,#0x0f
    xrl a,r7
    xch a,r7
    anl a,#0x0f
    xch a,r7
    xrl a,r7
    xch a,r7
    mov r6,a
    mov ar4,r7
    mov ar5,r6
    clr c
    mov a,#0xff
    subb a,r4
    mov a,#0x00
    subb a,r5
    jc %1
    ljmp %2
    %1:
    mov r5,#0xff
    ljmp %3
    %2:
    mov ar5,r7
    %3:
    mov _ACC,r5
    mov _scaled_knock_threshold,_ACC
    mov dptr,#_knock_threshold
    mov a,_ACC
    movx @dptr,a
    lcall _init_knock_filter_frequency
    %4:
    ret
} by {
    mov dptr,#_retained_knock_noise
    movx a,@dptr
    mul ab
    mov r2,a
    mov a,_B
    anl a,#0xf0
    jnz %1
    mov a,r2
    anl a,#0xf0
    orl a,_B
    swap a
    sjmp %3
    %1:
    mov a,#0xff
    %3:
    mov _scaled_knock_threshold,a
    mov dptr,#_knock_threshold
    movx @dptr,a
}

replace {
    mov _stock_r1,a
    mov dptr,#_knock_filter_index
    mov a,_stock_r1
    movx @dptr,a
    mov a,_stock_r1
    add a,#_knock_filter_frequencies
    mov dpl,a
    mov a,#0x00
    addc a,#(_knock_filter_frequencies >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov dptr,#_knock_filter_frequency
    mov a,r7
    movx @dptr,a
    lcall _configure_knock_filter
    %1:
    ret
} by {
    mov r1,a
    mov dptr,#_knock_filter_index
    movx @dptr,a
    mov dptr,#_knock_filter_frequencies
    mov a,r1
    movc a,@a+dptr
    mov dptr,#_knock_filter_frequency
    movx @dptr,a
}
