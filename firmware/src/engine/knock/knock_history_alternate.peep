// Clamp to the speed-dependent retard limit and advance the cylinder loop.
replace {
    mov a,_rpm_half_step_index
    add a, #_knock_maximum_retard_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_knock_maximum_retard_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    clr c
    mov a,_stock_r3
    subb a,_B
    jnc %1
    ljmp %2
    %1:
    mov _stock_r3,_B
    %2:
    mov a,_knock_window_override
    jnb acc.7,%3
    ljmp %4
    %3:
    mov a,_stock_r1
    add a, #_cylinder_retard
    mov r0,acc
    mov @r0,_stock_r3
    %4:
    inc _stock_r1
    ljmp %5
    %6:
    ret
} by {
    00948$:
    mov dptr,#_knock_maximum_retard_raw
    mov a,_rpm_half_step_index
    movc a,@a+dptr
    mov _B,a
    mov a,r3
    cjne a,_B,00951$
    00951$:
    jc 00952$
    mov r3,_B
    00952$:
    mov a,_knock_window_override
    anl a,#0x80
    jnz 00953$
    mov a,#_cylinder_retard
    add a,r1
    mov r0,a
    mov a,r3
    mov @r0,a
    00953$:
    inc r1
    cjne r1,#0x04,00954$
    ret
    00954$:
    ljmp 00955$
}
