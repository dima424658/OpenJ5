// Preserve the reset and sensor fault fallback in the cylinder-only routine.
replace {
    jnb _previous_fuel_mode_63,%1
    ljmp %2
    %1:
    mov _previous_knock_mask,#0x00
    mov r7,#0x00
    %3:
    cjne r7,#0x04,%4
    %4:
    jc %5
    ljmp %6
    %5:
    mov a,r7
    add a, #_cylinder_knock_interval
    mov dpl,a
    mov a,#0x00
    addc a, #(_cylinder_knock_interval >> 8)
    mov dph,a
    mov a,#0x00
    movx @dptr,a
    inc r7
    ljmp %3
    %6:
    mov r7,#0x00
    %7:
    cjne r7,#0x04,%8
    %8:
    jc %9
    ljmp %2
    %9:
    mov a,r7
    add a, #_cylinder_retard
    mov r0,acc
    mov @r0,#0x00
    inc r7
    ljmp %7
    %2:
    jnb _knock_fault_1f,%10
    ljmp %11
    %10:
    jnb _knock_fault_27,%12
    ljmp %11
    %12:
    jb _knock_fault_28,%13
    ljmp %14
    %13:
    %11:
    mov r7,#0x00
    %15:
    cjne r7,#0x04,%16
    %16:
    jc %17
    ljmp %18
    %17:
    mov a,r7
    add a, #_cylinder_retard
    mov r1,a
    mov a,_rpm_half_step_index
    add a, #_knock_maximum_retard_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_knock_maximum_retard_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r6,a
    mov @r1,ar6
    inc r7
    ljmp %15
    %18:
    ljmp %19
    %14:
} by {
    jb _previous_fuel_mode_63,00940$
    mov _previous_knock_mask,#0x00
    mov _B,#0x04
    mov dptr,#_cylinder_knock_interval
    clr a
    00941$:
    movx @dptr,a
    inc dptr
    djnz _B,00941$
    mov _B,#0x04
    mov r0,#_cylinder_retard
    00942$:
    mov @r0,#0x00
    inc r0
    djnz _B,00942$
    00940$:
    mov c,_knock_fault_1f
    orl c,_knock_fault_27
    orl c,_knock_fault_28
    jc 00943$
    sjmp 00944$
    00943$:
    mov _B,#0x04
    mov r0,#_cylinder_retard
    00945$:
    mov dptr,#_knock_maximum_retard_raw
    mov a,_rpm_half_step_index
    movc a,@a+dptr
    mov @r0,a
    inc r0
    djnz _B,00945$
    ret
}

// Read cylinder retard and remove its pending event while interrupts are disabled.
replace {
    clr _knock_event_seen
    mov dptr,#_knock_zone
    movx a,@dptr
    mov _active_knock_zone,a
    mov _stock_r1,#0x00
    %1:
    clr c
    mov a,_stock_r1
    subb a,#0x04
    jc %2
    ljmp %3
    %2:
    mov a,_stock_r1
    add a, #_cylinder_retard
    mov r1,a
    mov _stock_r3,@r1
    mov a,_stock_r1
    add a, #_knock_event_masks
    mov dpl,a
    mov a,#0x00
    addc a, #(_knock_event_masks >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r2,a
    clr _interrupts_enabled
    mov _ACC,_pending_knock_mask
    mov a,_stock_r2
    anl a,_ACC
    mov _B,a
    mov a,_B
    xrl a,_ACC
    mov _pending_knock_mask,a
    setb _interrupts_enabled
} by {
    00944$:
    mov r1,#0x00
    clr _knock_event_seen
    mov dptr,#_knock_zone
    movx a,@dptr
    mov _active_knock_zone,a
    00955$:
    mov a,#_cylinder_retard
    add a,r1
    mov r0,a
    mov a,@r0
    mov r3,a
    mov dptr,#_knock_event_masks
    mov a,r1
    movc a,@a+dptr
    mov _B,a
    mov r2,a
    clr _interrupts_enabled
    mov a,_pending_knock_mask
    anl _B,a
    xrl a,_B
    mov _pending_knock_mask,a
    setb _interrupts_enabled
}

