// Store the throttle history and quantize cylinder charge with the stock scaling and rounding.
replace {
    mov dptr,#_crank_throttle_position
    movx a,@dptr
    mov dptr,#_previous_throttle_position
    movx @dptr,a
    mov dptr,#_cylinder_charge
    movx a,@dptr
    mov _stock_r01,a
    inc dptr
    movx a,@dptr
    mov (_stock_r01 + 1),a
    mov dptr,#_charge_axis_minimum
    clr a
    movc a,@a+dptr
    mov _stock_r2,a
    mov dptr,#(_charge_axis_minimum + 0x0001)
    clr a
    movc a,@a+dptr
    mov _stock_r3,a
    lcall _subtract_u16_register_pairs
    mov _ACC,#0x00
    jnb _CY,%1
    ljmp %2
    %1:
    mov dptr,#_charge_axis_gain
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _shift_right_u16_3
    lcall _multiply_stock_u16_u8
    mov r6,_stock_r01
    mov r7,(_stock_r01 + 1)
    clr c
    mov a,r6
    subb a,#0xf0
    mov a,r7
    subb a,#0x00
    jc %3
    ljmp %4
    %3:
    mov r7,_stock_r0
    ljmp %5
    %4:
    mov r7,#0xf0
    %5:
    mov _ACC,r7
    %2:
    mov _B,_ACC
    mov a,_ACC
    clr c
    subb a,_charge_q4
    mov _ACC,a
    lcall _abs_accumulator_i8
    mov dptr,#_charge_delta_magnitude
    mov a,_ACC
    movx @dptr,a
    mov _charge_q4,_B
    mov r7,_B
    mov a,r7
    add a,#0x04
    mov r7,a
    mov a,r7
    swap a
    rl a
    anl a,#0x1f
    mov _charge_nearest_half_bin,a
    mov r7,_charge_q4
    mov a,#0x08
    add a, r7
    mov r7,a
    mov a,#0xf0
    anl a,r7
    mov _B,a
    mov a,_B
    swap a
    anl a,#0x0f
    mov _charge_nearest_bin,a
    mov r7,_rpm_q4
    mov a,#0x08
    add a, r7
    mov r7,a
    mov a,r7
    swap a
    anl a,#0x0f
    mov r7,a
    mov a,r7
    add a, _B
    mov _operating_point_index,a
    lcall _select_crank_fuel_path
    %6:
    ret
} by {
    mov dptr,#_crank_throttle_position
    movx a,@dptr
    mov dptr,#_previous_throttle_position
    movx @dptr,a
    mov dptr,#_cylinder_charge
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    mov dptr,#_charge_axis_minimum
    clr a
    movc a,@a+dptr
    mov r2,a
    mov dptr,#(_charge_axis_minimum + 1)
    clr a
    movc a,@a+dptr
    mov r3,a
    lcall _subtract_u16_register_pairs
    clr a
    jc 00950$
    mov dptr,#_charge_axis_gain
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _shift_right_u16_3
    lcall _multiply_stock_u16_u8
    mov a,r1
    jnz 00951$
    mov a,r0
    cjne a,#0xf0,00952$
    00952$:
    jc 00950$
    00951$:
    mov a,#0xf0
    00950$:
    mov _B,a
    clr c
    subb a,_charge_q4
    lcall _abs_accumulator_i8
    mov dptr,#_charge_delta_magnitude
    movx @dptr,a
    mov _charge_q4,_B
    mov a,_B
    add a,#0x04
    swap a
    rl a
    anl a,#0x1f
    mov _charge_nearest_half_bin,a
    mov a,_charge_q4
    add a,#0x08
    anl a,#0xf0
    mov _B,a
    swap a
    mov _charge_nearest_bin,a
    mov a,_rpm_q4
    add a,#0x08
    anl a,#0xf0
    swap a
    add a,_B
    mov _operating_point_index,a
}

// Dispatch the running fuel modes or compute the small dose at the startup exit RPM.
replace {
    mov dptr,#_cylinder_charge
    movx a,@dptr
    mov _stock_r01,a
    inc dptr
    movx a,@dptr
    mov (_stock_r01 + 1),a
    jnb _fuel_mode_flag_56,%1
    ljmp %2
    %1:
    lcall _finish_crank_without_fuel
    ljmp %3
    %2:
    jnb _fuel_mode_flag_55,%4
    ljmp %5
    %4:
    lcall _calculate_running_fuel
    ljmp %3
    %5:
    mov dptr,#_cranking_events
    movx a,@dptr
    mov r7,a
    mov a,r7
    inc a
    mov _ACC,a
    mov a,_ACC
    jnz %6
    ljmp %7
    %6:
    mov dptr,#_cranking_events
    mov a,_ACC
    movx @dptr,a
    %7:
    mov _stock_r0,#0x00
    mov a,_coolant_nearest_index
    add a, #_cranking_small_fuel_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_small_fuel_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r1,a
    mov a,_coolant_nearest_index
    add a, #_startup_exit_rpm_by_coolant
    mov dpl,a
    mov a,#0x00
    addc a, #(_startup_exit_rpm_by_coolant >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov b,#0x04
    mov a,r7
    div ab
    mov r7,a
    mov a,r7
    add a, #_cranking_rpm_correction_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_rpm_correction_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov a,_throttle_position
    add a, #_throttle_quantization_q4
    mov dpl,a
    mov a,#0x00
    addc a, #(_throttle_quantization_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _ACC,a
    mov r7,_ACC
    mov a,#0x08
    add a, r7
    mov r7,a
    mov a,r7
    swap a
    anl a,#0x0f
    mov r7,a
    mov a,r7
    add a, #_cranking_throttle_correction
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_throttle_correction >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_cranking_events
    movx a,@dptr
    mov r7,a
    mov a,r7
    swap a
    rl a
    anl a,#0x1f
    mov r7,a
    mov a,r7
    add a, #_cranking_speed_correction
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_speed_correction >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_retained_barometric_correction
    movx a,@dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
    mov dptr,#_poststart_fuel_floor
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    lcall _calculate_current_cranking
    %3:
    ret
} by {
    mov dptr,#_cylinder_charge
    movx a,@dptr
    mov r0,a
    inc dpl
    movx a,@dptr
    mov r1,a
    jb _fuel_mode_flag_56,00953$
    ljmp _finish_crank_without_fuel
    00953$:
    jb _fuel_mode_flag_55,00954$
    ljmp _calculate_running_fuel
    00954$:
    mov dptr,#_cranking_events
    movx a,@dptr
    inc a
    jz 00955$
    movx @dptr,a
    00955$:
    mov dptr,#_cranking_small_fuel_raw
    mov a,_coolant_nearest_index
    movc a,@a+dptr
    mov r0,#0x00
    mov r1,a
    mov dptr,#_startup_exit_rpm_by_coolant
    mov a,_coolant_nearest_index
    movc a,@a+dptr
    mov _B,#0x04
    div ab
    mov _B,a
    mov dptr,#_cranking_rpm_correction_raw
    mov a,_B
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_throttle_quantization_q4
    mov a,_throttle_position
    movc a,@a+dptr
    add a,#0x08
    anl a,#0xf0
    swap a
    mov dptr,#_cranking_throttle_correction
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_cranking_events
    movx a,@dptr
    rr a
    rr a
    rr a
    anl a,#0x1f
    mov dptr,#_cranking_speed_correction
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_retained_barometric_correction
    movx a,@dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
    mov dptr,#_poststart_fuel_floor
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
}

// Compute the small dose at the current RPM using the same other corrections.
replace {
    mov _stock_r0,#0x00
    mov a,_coolant_nearest_index
    add a, #_cranking_small_fuel_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_small_fuel_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r1,a
    mov dptr,#_rpm_eighth_bin
    movx a,@dptr
    mov r7,a
    mov a,r7
    add a, #_cranking_rpm_correction_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_rpm_correction_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov a,_throttle_position
    add a, #_throttle_quantization_q4
    mov dpl,a
    mov a,#0x00
    addc a, #(_throttle_quantization_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _ACC,a
    mov r7,_ACC
    mov a,#0x08
    add a, r7
    mov r7,a
    mov a,r7
    swap a
    anl a,#0x0f
    mov r7,a
    mov a,r7
    add a, #_cranking_throttle_correction
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_throttle_correction >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_cranking_events
    movx a,@dptr
    mov r7,a
    mov a,r7
    swap a
    rl a
    anl a,#0x1f
    mov r7,a
    mov a,r7
    add a, #_cranking_speed_correction
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_speed_correction >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_retained_barometric_correction
    movx a,@dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
    lcall _apply_large_cranking_fuel
    %1:
    ret
} by {
    mov dptr,#_cranking_small_fuel_raw
    mov a,_coolant_nearest_index
    movc a,@a+dptr
    mov r0,#0x00
    mov r1,a
    mov dptr,#_rpm_eighth_bin
    movx a,@dptr
    mov _B,a
    mov dptr,#_cranking_rpm_correction_raw
    mov a,_B
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_throttle_quantization_q4
    mov a,_throttle_position
    movc a,@a+dptr
    add a,#0x08
    anl a,#0xf0
    swap a
    mov dptr,#_cranking_throttle_correction
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_cranking_events
    movx a,@dptr
    rr a
    rr a
    rr a
    anl a,#0x1f
    mov dptr,#_cranking_speed_correction
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_retained_barometric_correction
    movx a,@dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
}

// Advance the cyclic cranking counter and replace the small dose during the large-dose cycles.
replace {
    jb _startup_flag_51,%1
    ljmp %2
    %1:
    mov dptr,#_cranking_cycle_index
    movx a,@dptr
    mov r7,a
    mov dptr,#_cranking_cycle_period
    clr a
    movc a,@a+dptr
    mov r6,a
    clr c
    mov a,r7
    subb a,r6
    jnc %3
    ljmp %4
    %3:
    mov dptr,#_cranking_cycle_index
    mov a,#0x00
    movx @dptr,a
    %4:
    mov dptr,#_cranking_cycle_index
    movx a,@dptr
    mov _ACC,a
    mov r7,_ACC
    mov a,r7
    inc a
    movx @dptr,a
    mov dptr,#_cranking_large_cycle_count
    clr a
    movc a,@a+dptr
    mov r7,a
    clr c
    mov a,_ACC
    subb a,r7
    jc %5
    ljmp %2
    %5:
    mov _stock_r0,#0x00
    mov a,_coolant_nearest_index
    add a, #_cranking_large_fuel_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_large_fuel_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r1,a
    mov a,_throttle_position
    add a, #_throttle_quantization_q4
    mov dpl,a
    mov a,#0x00
    addc a, #(_throttle_quantization_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _ACC,a
    mov r7,_ACC
    mov a,#0x08
    add a, r7
    mov r7,a
    mov a,r7
    swap a
    anl a,#0x0f
    mov r7,a
    mov a,r7
    add a, #_cranking_throttle_correction
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_throttle_correction >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_cranking_events
    movx a,@dptr
    mov r7,a
    mov a,r7
    swap a
    rl a
    anl a,#0x1f
    mov r7,a
    mov a,r7
    add a, #_cranking_speed_correction
    mov dpl,a
    mov a,#0x00
    addc a, #(_cranking_speed_correction >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_retained_barometric_correction
    movx a,@dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
    %2:
    lcall _publish_cranking_fuel
    %6:
    ret
} by {
    jnb _startup_flag_51,_publish_cranking_fuel
    mov dptr,#_cranking_cycle_period
    clr a
    movc a,@a+dptr
    mov _B,a
    mov dptr,#_cranking_cycle_index
    movx a,@dptr
    clr c
    subb a,_B
    jc 00956$
    clr a
    mov dptr,#_cranking_cycle_index
    movx @dptr,a
    00956$:
    mov dptr,#_cranking_large_cycle_count
    clr a
    movc a,@a+dptr
    mov _B,a
    mov dptr,#_cranking_cycle_index
    movx a,@dptr
    inc a
    movx @dptr,a
    dec a
    clr c
    subb a,_B
    jnc _publish_cranking_fuel
    mov dptr,#_cranking_large_fuel_raw
    mov a,_coolant_nearest_index
    movc a,@a+dptr
    mov r0,#0x00
    mov r1,a
    mov dptr,#_throttle_quantization_q4
    mov a,_throttle_position
    movc a,@a+dptr
    add a,#0x08
    anl a,#0xf0
    swap a
    mov dptr,#_cranking_throttle_correction
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_cranking_events
    movx a,@dptr
    rr a
    rr a
    rr a
    anl a,#0x1f
    mov dptr,#_cranking_speed_correction
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov dptr,#_retained_barometric_correction
    movx a,@dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    lcall _shift_left_saturating_1
}

// Store cyclic fuel and mark the value for the shared correction stage.
replace {
    mov dptr,#_cranking_fuel
    mov a,_stock_r01
    movx @dptr,a
    mov a,(_stock_r01 + 1)
    inc dptr
    movx @dptr,a
    setb _cranking_fuel_selected
    lcall _apply_fuel_corrections
    %1:
    ret
} by {
    mov dptr,#_cranking_fuel
    mov a,r0
    movx @dptr,a
    inc dpl
    mov a,r1
    movx @dptr,a
    setb _cranking_fuel_selected
    ljmp _apply_fuel_corrections
}
