    clr _mdu_interrupted
    mov _mdu_0,_B
    mov _mdu_1,r0
    mov _mdu_2,r1
    mov _mdu_3,#0x00
    mov _mdu_4,#0x0c
    mov _mdu_5,#0x00
    nop
    nop
    nop
    nop
    nop
    nop
    mov r2,_mdu_0
    mov r3,_mdu_1
    mov a,_mdu_2
    mov a,_mdu_3
    mov a,_mdu_4
    mov a,_mdu_5
    jb _mdu_interrupted,00972$
    anl _sfr_f6,#0xf0
