    orl _P4,#0x0f
}

// Reset the cranking cycle counters before checking the exit condition.
replace {
    jnb _async_fuel_on_repeat_start,%1
    ljmp %2
    %1:
    setb _async_cranking_fuel_done
    %2:
    mov dptr,#_cranking_cycle_index
    mov a,#0x00
    movx @dptr,a
    mov dptr,#_time_since_start_f873
    movx @dptr,a
    lcall _advance_cranking_exit
    %3:
    ret
} by {
    jb _async_fuel_on_repeat_start,00974$
    setb _async_cranking_fuel_done
    00974$:
    clr a
    mov dptr,#_cranking_cycle_index
    movx @dptr,a
    clr a
    mov dptr,#_time_since_start_f873
    movx @dptr,a
}

// Use the two cranking exit thresholds and keep the firmware flag transitions.
replace {
    mov dptr,#_time_since_start_f873
    movx a,@dptr
    mov r7,a
    mov a,r7
    inc a
    mov _ACC,a
    mov a,_ACC
    jnz %1
    ljmp %2
    %1:
    mov dptr,#_time_since_start_f873
    mov a,_ACC
    movx @dptr,a
    %2:
    mov dptr,#_time_since_start_f873
    movx a,@dptr
    mov r7,a
    mov dptr,#_cranking_sync_delay
    clr a
    movc a,@a+dptr
    mov r6,a
    clr c
    mov a,r7
    subb a,r6
    jnc %3
    ljmp %4
    %3:
    setb _event_flag_31
    %4:
    jb _startup_flag_53,%5
    ljmp %6
    %5:
    mov a,_coolant_nearest_index
    add a, #_startup_exit_rpm_by_coolant
    mov dpl,a
    mov a,#0x00
    addc a, #(_startup_exit_rpm_by_coolant >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    clr c
    mov a,_engine_rpm_10
    subb a,_B
    jc %7
    ljmp %8
    %7:
    mov dptr,#_startup_exit_rpm_low
    clr a
    movc a,@a+dptr
    mov r7,a
    clr c
    mov a,_engine_rpm_10
    subb a,r7
    mov _startup_flag_51,c
    jnb _startup_flag_51,%9
    ljmp %10
    %9:
    mov dptr,#_start_exit_pending
    mov a,#0x00
    movx @dptr,a
    %10:
    lcall _apply_cranking_outputs
    ljmp %11
    %8:
    clr _startup_flag_53
    clr _startup_flag_51
    %6:
    lcall _select_knock_regulation_zone
    %11:
    ret
} by {
    mov dptr,#_time_since_start_f873
    movx a,@dptr
    inc a
    jz 00975$
    movx @dptr,a
    00975$:
    mov dptr,#_cranking_sync_delay
    clr a
    movc a,@a+dptr
    mov _B,a
    mov dptr,#_time_since_start_f873
    movx a,@dptr
    cjne a,_B,00976$
    00976$:
    jc 00977$
    setb _event_flag_31
    00977$:
    jnb _startup_flag_53,00978$
    mov dptr,#_startup_exit_rpm_by_coolant
    mov a,_coolant_nearest_index
    movc a,@a+dptr
    mov _B,a
    mov a,_engine_rpm_10
    clr c
    subb a,_B
    jnc 00979$
    mov dptr,#_startup_exit_rpm_low
    clr a
    movc a,@a+dptr
    mov _B,a
    mov a,_engine_rpm_10
    clr c
    subb a,_B
    mov _startup_flag_51,c
    jc _apply_cranking_outputs
    clr a
    mov dptr,#_start_exit_pending
    movx @dptr,a
    sjmp _apply_cranking_outputs
    00979$:
    clr _startup_flag_53
    clr _startup_flag_51
    00978$:
    ljmp _select_knock_regulation_zone
}
