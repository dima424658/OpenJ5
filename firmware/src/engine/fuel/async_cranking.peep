// Clear the saved start pulse before skipping its compare-register write.
replace {
    mov dptr,#_start_exit_pending
    mov a,#0x00
    movx @dptr,a
    lcall _skip_async_cranking
    %1:
    ret
} by {
    clr a
    mov dptr,#_start_exit_pending
    movx @dptr,a
}

// Skip the compare-register write on an already armed pulse.
replace {
    _skip_async_cranking:
    lcall _finish_async_cranking
    %1:
    ret
} by {
    _skip_async_cranking:
    ljmp _finish_async_cranking
}

