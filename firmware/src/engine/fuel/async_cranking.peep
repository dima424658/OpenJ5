    mov a,#0x00
    addc a, #(_cranking_async_fuel_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov r6,_B
    mov b,r7
    mov a,r6
    mul ab
    mov r7,a
    mov r5,b
    mov _ACC,r5
    mov dptr,#_start_exit_pending
    mov a,_ACC
    movx @dptr,a
    mov a,_ACC
    jz %15
    ljmp %16
    %15:
    lcall _cancel_async_cranking
    ljmp %10
    %16:
    mov _stock_r1,_ACC
    mov _stock_r0,#0x00
    mov _stock_r3,_ACC
    mov _stock_r2,#0x00
    mov a,#0x80
    xrl a,_fuel_correction
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov a,_fuel_correction
    jb acc.7,%17
    ljmp %18
    %17:
    lcall _add_u16_register_pairs
    jb _CY,%19
    ljmp %18
    %19:
    mov _stock_r01,#0xff
    mov (_stock_r01 + 1),#0xff
    %18:
    mov dptr,#_injector_static_factor
    clr a
    movc a,@a+dptr
    mov _B,a
    lcall _multiply_stock_u16_u8
    mov _stock_r23,_injector_voltage_offset
    mov (_stock_r23 + 1),#0x00
    lcall _add_u16_register_pairs
    mov _B,#0x10
    lcall _multiply_stock_u16_u8
    %20:
    clr _mdu_interrupted
    mov _mdu_0,_B
    mov _mdu_1,_stock_r0
    mov _mdu_2,_stock_r1
    mov _mdu_3,#0x00
    mov _mdu_4,#0x0c
    mov _mdu_5,#0x00
    nop
    nop
    nop
    nop
    nop
    nop
    mov _stock_r2,_mdu_0
    mov _stock_r3,_mdu_1
    mov _ACC,_mdu_2
    mov _ACC,_mdu_3
    mov _ACC,_mdu_4
    mov _ACC,_mdu_5
    jnb _mdu_interrupted,%21
    ljmp %20
    %21:
    anl _sfr_f6,#0xf0
    clr _EA
    mov a,_output_mask_7c
    anl a,#0x0f
    mov _ACC,a
    mov a,_ACC
    jz %22
    ljmp %23
    %22:
    anl _P4,#0xf0
    %23:
    mov _compare_base_low,_ACC
