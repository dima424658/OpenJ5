// The eight bytes lie in one XDATA page. Walk them with DPL, using the
// active register bank's R0 as the count and leaving zero in A.
replace {
    mov r6,#_fuel_history_f839
    mov r7,#(_fuel_history_f839 >> 8)
    mov r5,#0x08
    %1:
    mov dpl,r6
    mov dph,r7
    mov a,#0x00
    movx @dptr,a
    inc dptr
    mov r6,dpl
    mov r7,dph
    dec r5
    mov a,r5
    jz %2
    ljmp %1
    %2:
} by {
    clr a
    mov dptr,#_fuel_history_f839
    mov r0,#0x08
    %1:
    movx @dptr,a
    inc dpl
    djnz r0,%1
    %2:
}
