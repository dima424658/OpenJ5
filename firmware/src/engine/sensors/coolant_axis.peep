// Relax the local conditional branches with the built-in rules disabled.
replace {
    jnc %1
    ljmp %2
    %1:
} by {
    jc %2
    %1:
}

// Prepare the rounded dividend in A without a temporary register.
replace {
    mov a,#%1
    add a,_coolant_temperature_raw
    mov r7,a
    mov b,#%2
    mov a,r7
    div ab
} by {
    mov a,_coolant_temperature_raw
    add a,#%1
    mov b,#%2
    div ab
}

// Saturate the rounded quotient and store it directly from A.
replace {
    mov r7,a
    cjne r7,#%1,%2
    %2:
    jc %3
    %4:
    mov r7,#%1
    %3:
    mov _coolant_nearest_index,r7
} by {
    cjne a,#%1,%2
    %2:
    jc %3
    %4:
    mov a,#%1
    %3:
    mov _coolant_nearest_index,a
}

// DIV supplies both quotient in A and remainder in B. The quotient's
// compare, clamp and store leave B alone, so the remainder needs no second DIV.
replace {
    mov r7,_coolant_temperature_raw
    mov ar6,r7
    mov b,#%1
    mov a,r6
    div ab
    mov r6,a
    cjne r6,#%2,%3
    %3:
    jc %4
    %6:
    mov r6,#%2
    %4:
    mov dptr,#_idle_temp_index
    mov a,r6
    movx @dptr,a
    mov b,#%1
    mov a,r7
    div ab
    mov r7,b
    mov dptr,#_idle_temp_fraction
    mov a,r7
    mov b,#%5
    mul ab
    movx @dptr,a
} by {
    mov a,_coolant_temperature_raw
    mov b,#%1
    div ab
    cjne a,#%2,%3
    %3:
    jc %4
    %6:
    mov a,#%2
    %4:
    mov dptr,#_idle_temp_index
    movx @dptr,a
    mov a,b
    mov b,#%5
    mul ab
    mov dptr,#_idle_temp_fraction
    movx @dptr,a
}

// The linker map verifies the continuation immediately follows this block.
replace {
    lcall _coolant_update_continued
    %1:
    ret
} by {
    %1:
}
