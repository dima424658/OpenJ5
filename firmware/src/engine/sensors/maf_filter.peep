// Add the latest sample and subtract the old output in R2:R1.
replace {
    mov r7,_ACC
    mov r5,_stock_r12
    mov r6,(_stock_r12 + 1)
    mov r4,#0x00
    mov a,r7
    add a,r5
    mov r5,a
    mov a,r4
    addc a,r6
    mov r6,a
    mov r7,_stock_r3
    mov a,r5
    clr c
    subb a,r7
    mov r5,a
    mov a,r6
    subb a,r4
    mov r6,a
    mov _stock_r12,r5
    mov (_stock_r12 + 1),r6
} by {
    add a,r1
    xch a,r2
    addc a,#0x00
    clr c
    xch a,r2
    subb a,r3
    mov r1,a
    mov a,r2
    subb a,#0x00
    mov r2,a
}

// Recombine the nibbles of the biased state without changing R2:R1.
replace {
    mov a,#0x08
    add a,r5
    mov r5,a
    mov a,#0x00
    addc a,r6
    mov r6,a
    mov ar7,r6
    mov a,r7
    swap a
    anl a,#0xf0
    mov _stock_r3,a
    mov a,r6
    swap a
    xch a,r5
    swap a
    anl a,#0x0f
    xrl a,r5
    xch a,r5
    anl a,#0x0f
    xch a,r5
    xrl a,r5
    xch a,r5
    mov r6,a
    mov _ACC,r5
} by {
    mov a,r1
    add a,#0x08
    mov r3,a
    mov a,r2
    addc a,#0x00
    anl a,#0x0f
    swap a
    xch a,r3
    anl a,#0xf0
    swap a
    add a,r3
}
