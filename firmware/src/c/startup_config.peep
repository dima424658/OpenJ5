// Consecutive stores keep the current initialization byte in A.
replace {
    mov a,_ACC
    movx @dptr,a
} by {
    movx @dptr,a
}

replace {
    mov _ACC,#0x00
} by {
    clr a
}

replace {
    mov _ACC,#%1
} by {
    mov a,#%1
}

replace {
    mov _ACC,a
} by {
}

replace {
    mov %1,_ACC
} by {
    mov %1,a
}

replace {
    orl acc,#0x20
} by {
    orl a,#0x20
}

replace {
    lcall _init_startup_control_state
    %1:
    ret
} by {
    %1:
}
