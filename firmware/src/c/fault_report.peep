// Initialize the three stock pointers and scan history using the selected register bank.
replace {
    mov r0,#_diagnostic_record_count
    mov @r0,#0x00
    mov dptr,#_diagnostic_records
    mov a,#0x00
    movx @dptr,a
    mov ar7,a
    mov _stock_r1,a
    %1:
    clr c
    mov a,_stock_r1
    subb a,#0x40
    jc %2
    ljmp %3
    %2:
    mov a,_stock_r1
    add a, #_fault_history
    mov dpl,a
    mov a,#0x00
    addc a, #(_fault_history >> 8)
    mov dph,a
    movx a,@dptr
    mov r6,a
    anl ar6,#0xf0
    mov ar5,r6
    mov a,r6
    jnz %4
    ljmp %5
    %4:
} by {
    clr a
    mov r0,#_diagnostic_record_count
    mov @r0,a
    mov r1,a
    mov dptr,#_fault_history
    mov r2,#0x40
    mov _DPSEL,#0x03
    mov dptr,#_diagnostic_fault_codes
    mov _DPSEL,#0x04
    mov dptr,#_diagnostic_records
    movx @dptr,a
    mov _DPSEL,#0x00
    00971$:
    movx a,@dptr
    anl a,#0xf0
    mov r4,a
    jz 00970$
}

// Read both code bytes using a single ROM address and write the packed record using DPTR bank 4.
replace {
    mov a,_stock_r1
    mov b,#0x02
    mul ab
    add a, #_diagnostic_fault_codes
    mov r4,a
    mov a,#(_diagnostic_fault_codes >> 8)
    addc a, b
    mov r6,a
    mov dpl,r4
    mov dph,r6
    clr a
    movc a,@a+dptr
    mov r3,a
    mov dpl,r4
    mov dph,r6
    inc dptr
    clr a
    movc a,@a+dptr
    mov _B,a
    mov dpl,r7
    mov dph,#(_diagnostic_records >> 8)
    mov a,r3
    movx @dptr,a
    mov ar4,r7
    mov r6,#0x00
    mov a,#0x01
    add a, r4
    mov r2,a
    mov a,#0x00
    addc a, r6
    mov r3,a
    mov dpl,r2
    mov a,#(_diagnostic_records >> 8)
    add a,r3
    mov dph,a
    mov a,_B
    movx @dptr,a
    mov a,#0x02
    add a, r4
    mov r4,a
    mov a,#0x00
    addc a, r6
    mov r6,a
    mov dpl,r4
    mov a,#(_diagnostic_records >> 8)
    add a,r6
    mov dph,a
    mov a,r5
    movx @dptr,a
    mov ar6,r7
    mov a,#0x03
    add a, r6
    mov r7,a
    mov dpl,r7
    mov dph,#(_diagnostic_records >> 8)
    mov a,#0x00
    movx @dptr,a
    mov r0,#_diagnostic_record_count
    inc @r0
    %1:
    inc _stock_r1
    ljmp %2
    %3:
    ret
} by {
    mov _DPSEL,#0x03
    mov dptr,#_diagnostic_fault_codes
    mov a,r1
    mov _B,#0x02
    mul ab
    add a,dpl
    mov dpl,a
    clr a
    addc a,dph
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r3,a
    mov a,#0x01
    movc a,@a+dptr
    mov _B,a
    mov _DPSEL,#0x04
    mov a,r3
    movx @dptr,a
    inc dptr
    mov a,_B
    movx @dptr,a
    inc dptr
    mov a,r4
    movx @dptr,a
    inc dptr
    clr a
    movx @dptr,a
    mov _DPSEL,#0x00
    mov r0,#_diagnostic_record_count
    inc @r0
    00970$:
    inc dptr
    inc r1
    djnz r2,00971$
    ret
}

// Keep history and its parallel timers in banks 3 and 0 during the countdown.
replace {
    mov dptr,#_coolant_warmup_flags
    movx a,@dptr
    mov r7,a
    mov ar6,r7
    mov a,r7
    jnz %1
    ljmp %2
    %1:
    mov a,r6
    jb acc.7,%3
    ljmp %4
    %3:
    %2:
    ljmp %5
    %4:
    mov r7,#0x00
    %6:
    cjne r7,#0x40,%7
    %7:
    jc %8
    ljmp %9
    %8:
    mov a,r7
    add a, #_fault_history_timers
    mov dpl,a
    mov a,#0x00
    addc a, #(_fault_history_timers >> 8)
    mov dph,a
    movx a,@dptr
    mov r6,a
    mov a,r6
    jnz %10
    ljmp %11
    %10:
    mov a,r7
    add a, #_fault_history_timers
    mov dpl,a
    mov a,#0x00
    addc a, #(_fault_history_timers >> 8)
    mov dph,a
    dec r6
    mov a,r6
    movx @dptr,a
    mov a,r6
    jz %12
    ljmp %11
    %12:
    mov a,r7
    add a, #_fault_history
    mov dpl,a
    mov a,#0x00
    addc a, #(_fault_history >> 8)
    mov dph,a
    mov a,#0x00
    movx @dptr,a
    %11:
    inc r7
    ljmp %6
    %9:
    mov dptr,#_coolant_warmup_flags
    movx a,@dptr
} by {
    mov dptr,#_coolant_warmup_flags
    movx a,@dptr
    jz 00112$
    jb acc.7,00112$
    mov _DPSEL,#0x03
    mov dptr,#_fault_history
    mov r2,#0x40
    mov _DPSEL,#0x00
    mov dptr,#_fault_history_timers
    %6:
    movx a,@dptr
    jz %11
    dec a
    movx @dptr,a
    jnz %11
    clr a
    mov _DPSEL,#0x03
    movx @dptr,a
    mov _DPSEL,#0x00
    %11:
    inc dptr
    mov _DPSEL,#0x03
    inc dptr
    mov _DPSEL,#0x00
    djnz r2,%6
    mov dptr,#_coolant_warmup_flags
    movx a,@dptr
}

// Set the completion flag with the accumulator-immediate opcode.
replace {
    orl acc,#0x80
    movx @dptr,a
    %1:
    ret
} by {
    orl a,#0x80
    movx @dptr,a
    %1:
    ret
}
