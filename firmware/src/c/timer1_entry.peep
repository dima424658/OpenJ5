    clr _service_request_79
    setb _service_event_pending
    setb _service_dispatch_7c
    mov _service_event_timer,#0x0c
    mov dptr,#_serial_reply_byte_3
    movx a,@dptr
    xrl a,#0xa0
    jnz 00982$
    mov _serial_tx_count,#0x06
    sjmp 00983$
    00982$:
    mov _serial_tx_count,#0x0e
    00983$:
    sjmp _service_timer1_iac
}

// Keep the independently timed diagnostic coil outputs in the Timer 1 slot.
replace {
    jnb _fuel_mode_flag_56,%1
    ljmp %2
    %1:
    mov a,_output_flags_7c
    anl a,#0x30
    jnz %3
    ljmp %2
    %3:
    mov dptr,#_coil_test_duration
    movx a,@dptr
    mov r7,a
    dec r7
    mov a,r7
    jz %4
    ljmp %5
    %4:
    orl _P5,#0x06
    ljmp %2
    %5:
    mov dptr,#_coil_test_duration
    mov a,r7
    movx @dptr,a
    mov dptr,#_coil_test_period
    movx a,@dptr
    dec a
    mov r7,a
    mov a,r7
    movx @dptr,a
    mov a,r7
    jz %6
    ljmp %2
    %6:
    mov dptr,#_coil_test_period
    mov a,#0x05
    movx @dptr,a
    mov a,_output_flags_7c
    jb acc.4,%7
    ljmp %8
    %7:
    cpl _coil_1_level
    ljmp %2
    %8:
    cpl _coil_2_level
    %2:
    lcall _service_timer1_iac
    %9:
    ret
} by {
    jb _fuel_mode_flag_56,00986$
    mov a,_output_flags_7c
    anl a,#0x10
    jz 00984$
    mov dptr,#_coil_test_duration
    movx a,@dptr
    dec a
    jz 00985$
    movx @dptr,a
    mov dptr,#_coil_test_period
    movx a,@dptr
    dec a
    movx @dptr,a
    jnz 00986$
    mov a,#0x05
    movx @dptr,a
    cpl _coil_1_level
    sjmp 00986$
    00984$:
    mov a,_output_flags_7c
    anl a,#0x20
    jz 00986$
    mov dptr,#_coil_test_duration
    movx a,@dptr
    dec a
    jz 00985$
    movx @dptr,a
    mov dptr,#_coil_test_period
    movx a,@dptr
    dec a
    movx @dptr,a
    jnz 00986$
    mov a,#0x05
    movx @dptr,a
    cpl _coil_2_level
    sjmp 00986$
    00985$:
    orl _P5,#0x06
    00986$:
}
