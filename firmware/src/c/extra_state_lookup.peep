replace {
    mov _ACC,#0x00
} by {
    clr a
}

// Insert an input bit in A with no temporary register or intermediate carry.
replace {
    mov a,_ACC
    add a,acc
    mov r7,a
    mov c,%1
    clr a
    rlc a
    mov r6,a
    mov a,r6
    orl ar7,a
    mov _ACC,r7
} by {
    mov c,%1
    rlc a
}

// MOVC takes the complete eight-bit index in A.
replace {
    mov a,_ACC
    add a,#_supplemental_state_lookup
    mov dpl,a
    mov a,#0x00
    addc a,#(_supplemental_state_lookup >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov a,#%1
    anl a,r7
    mov _ACC,a
} by {
    mov dptr,#_supplemental_state_lookup
    movc a,@a+dptr
    anl a,#%1
}

replace {
    mov _state_mask,_ACC
    mov a,_ACC
    rl a
    mov r7,a
    mov a,_ACC
    mov _ACC,r7
} by {
    mov _state_mask,a
    rl a
}

replace {
    mov a,_ACC
    orl _state_mask,a
} by {
    orl _state_mask,a
}

// Feed the masked lookup result to the shared bit, retaining the shift carry.
replace {
    mov c,_CARRY
    clr a
    rlc a
    mov r7,a
    mov c,_ACC_BIT0
    mov _CARRY,c
    mov a,_ACC
    clr c
    rrc a
    mov r6,a
    mov a,r7
    rr a
    anl a,#0x80
    mov r7,a
    mov a,r7
    orl a,r6
    mov _ACC,a
} by {
    rrc a
}

replace {
    jb _input_bit,%1
    ljmp %2
    %1:
    cpl _CARRY
    %2:
} by {
    jnb _input_bit,%2
    cpl c
    %2:
}

replace {
    cpl _CARRY
} by {
    cpl c
}

replace {
    mov c,_CARRY
    mov _state_bit_00,c
    mov c,_CARRY
    clr a
    rlc a
    mov r7,a
    mov c,_ACC_SIGN
    mov _CARRY,c
    mov a,_ACC
    add a,acc
    mov r6,a
    mov a,r7
    orl a,r6
    mov _ACC,a
} by {
    mov _state_bit_00,c
    rlc a
}

// The generation loop advances the cursor only on odd iterations.
replace {
    mov c,_CARRY
    clr a
    rlc a
    mov r7,a
    mov _ACC,_stock_r4
    mov c,_ACC_BIT0
    mov _CARRY,c
    mov a,_ACC
    clr c
    rrc a
    mov r6,a
    mov a,r7
    rr a
    anl a,#0x80
    mov r7,a
    mov a,r7
    orl a,r6
    mov _ACC,a
    jb _CARRY,%1
    ljmp %2
    %1:
    lcall _mix_next_extra_state_byte
    ljmp %3
    %2:
    lcall _mix_extra_state_byte
    %3:
} by {
    mov a,_stock_r4
    rrc a
    jc %1
    lcall _mix_extra_state_byte
    sjmp %3
    %1:
    lcall _mix_next_extra_state_byte
    %3:
}

// Each loop exceeds the range of a backward DJNZ.
replace {
    mov a,_stock_r4
    dec a
    mov r7,a
    mov _stock_r4,r7
    mov a,r7
    jz %1
    ljmp %2
    %1:
} by {
    djnz _stock_r4,%1
    sjmp 00999$
    %1:
    ljmp %2
    00999$:
}
