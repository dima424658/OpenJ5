    ljmp %5
    %4:
    mov dptr,#_misfire_fuel_cut_events
    movx a,@dptr
    mov r7,a
    cjne r7,#0xff,%6
    %6:
    jc %7
    ljmp %8
    %7:
    inc r7
    %8:
    mov dptr,#_misfire_fuel_cut_events
    mov a,r7
    movx @dptr,a
    mov dptr,#_misfire_fuel_cut_event_limit
    clr a
    movc a,@a+dptr
    mov r6,a
    clr c
    mov a,r6
    subb a,r7
    jc %9
    ljmp %10
    %9:
    mov a,_knock_mask_index
    jb acc.0,%11
    ljmp %12
    %11:
    %10:
    lcall _combine_misfire_event_flags
    ljmp %5
    %12:
} by {
    jb _deceleration_fuel_cut,00950$
