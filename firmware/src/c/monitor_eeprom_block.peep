// Limit a write to the current page and advance the descriptor only on success.
replace {
    mov dptr,#_monitor_eeprom_offset
    movx a,@dptr
    mov _stock_r0,a
    mov dptr,#_monitor_eeprom_remaining
    movx a,@dptr
    mov _stock_r2,a
    mov dptr,#_monitor_buffer_low
    movx a,@dptr
    mov r7,a
    mov dptr,#_monitor_buffer_high
    movx a,@dptr
    mov r5,a
    mov r6,#0x00
    mov ar6,r5
    mov r5,#0x00
    mov r4,#0x00
    mov a,r7
    orl ar5,a
    mov a,r4
    orl ar6,a
    mov ((_STOCK_DPTR >> 0) & 0xFF),r5
    mov ((_STOCK_DPTR >> 8) & 0xFF),r6
    mov r7,_stock_r0
    mov a,#0x0f
    anl a,r7
    setb c
    subb a,#0x10
    cpl a
    mov r7,a
    clr c
    mov a,_stock_r2
    subb a,r7
    jc %1
    ljmp %2
    %1:
    mov r6,_stock_r2
    ljmp %3
    %2:
    mov ar6,r7
    %3:
    mov _stock_r1,r6
    mov _stock_r3,_stock_r1
    lcall _monitor_eeprom_write_fragment
    jb _CY,%4
    ljmp %5
    %4:
    ljmp %6
    %5:
    mov a,_stock_r3
    add a, _stock_r0
    mov _stock_r0,a
    mov a,_stock_r2
    clr c
    subb a,_stock_r3
    mov _stock_r2,a
    mov r6,((_STOCK_DPTR >> 0) & 0xFF)
    mov r7,((_STOCK_DPTR >> 8) & 0xFF)
    mov dptr,#_monitor_buffer_low
    mov a,r6
    movx @dptr,a
    mov dptr,#_monitor_buffer_high
    mov a,r7
    movx @dptr,a
    mov dptr,#_monitor_eeprom_offset
    mov a,_stock_r0
    movx @dptr,a
    mov dptr,#_monitor_eeprom_remaining
    mov a,_stock_r2
    movx @dptr,a
    clr _CY
    %6:
    ret
} by {
    mov dptr,#_monitor_eeprom_offset
    movx a,@dptr
    mov r0,a
    mov dptr,#_monitor_eeprom_remaining
    movx a,@dptr
    mov r2,a
    mov dptr,#_monitor_buffer_low
    movx a,@dptr
    mov _B,a
    mov dptr,#_monitor_buffer_high
    movx a,@dptr
    mov dpl,_B
    mov dph,a
    mov a,r0
    anl a,#0x0f
    cpl a
    inc a
    add a,#0x10
    mov _B,a
    mov a,r2
    cjne a,_B,00970$
    00970$:
    jc 00971$
    mov a,_B
    00971$:
    mov r1,a
    mov r3,a
    lcall _monitor_eeprom_write_fragment
    jc 00972$
    mov a,r0
    add a,r3
    mov r0,a
    mov a,r2
    clr c
    subb a,r3
    mov r2,a
    mov _B,dph
    mov a,dpl
    mov dptr,#_monitor_buffer_low
    movx @dptr,a
    mov a,_B
    mov dptr,#_monitor_buffer_high
    movx @dptr,a
    mov a,r0
    mov dptr,#_monitor_eeprom_offset
    movx @dptr,a
    mov a,r2
    mov dptr,#_monitor_eeprom_remaining
    movx @dptr,a
    clr c
    00972$:
    ret
}

// Select verification and jump to the common transaction.
replace {
    setb _verify_eeprom_data
    lcall _monitor_eeprom_read_or_verify
    %1:
    ret
} by {
    setb _verify_eeprom_data
    sjmp _monitor_eeprom_read_or_verify
}

// Select reading and fall through to the common transaction.
replace {
    clr _verify_eeprom_data
    lcall _monitor_eeprom_read_or_verify
    %1:
    ret
} by {
    clr _verify_eeprom_data
}

// Preserve the repeated start, byte comparison, and carry result.
replace {
    orl _sfr_b9,#0x80
    anl _P1,#0xdf
    lcall _monitor_eeprom_delay
    clr _eeprom_sda
    lcall _monitor_eeprom_delay
    clr _eeprom_scl
    mov r7,_monitor_eeprom_device
    anl ar7,#0x6f
    mov a,r7
    add a,acc
    mov r7,a
    mov a,#0xa0
    orl a,r7
    mov _ACC,a
    lcall _monitor_eeprom_send_byte
    jb _CY,%1
    ljmp %2
    %1:
    ljmp %3
    %2:
    mov _ACC,_stock_r0
    lcall _monitor_eeprom_send_byte
    jb _CY,%4
    ljmp %5
    %4:
    ljmp %3
    %5:
    lcall _monitor_eeprom_delay
    setb _eeprom_scl
    orl _sfr_b9,#0x80
    anl _P1,#0xdf
    lcall _monitor_eeprom_delay
    clr _eeprom_sda
    lcall _monitor_eeprom_delay
    clr _eeprom_scl
    mov r7,_monitor_eeprom_device
    anl ar7,#0x6f
    mov a,r7
    add a,acc
    mov r7,a
    mov a,#0xa1
    orl a,r7
    mov _ACC,a
    lcall _monitor_eeprom_send_byte
    jb _CY,%6
    ljmp %7
    %6:
    ljmp %3
    %7:
    lcall _monitor_eeprom_read_byte
    jb _verify_eeprom_data,%8
    ljmp %9
    %8:
    mov _B,_ACC
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    movx a,@dptr
    mov _ACC,a
    mov a,_B
    cjne a,_ACC,%10
    ljmp %11
    %10:
    setb _CY
    ljmp %3
    %9:
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,_ACC
    movx @dptr,a
    %11:
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    mov a,_stock_r1
    dec a
    mov r7,a
    mov _stock_r1,r7
    mov a,r7
    jz %12
    ljmp %7
    %12:
    setb _eeprom_sda
    orl _sfr_b9,#0x80
    orl _P1,#0x20
    lcall _monitor_eeprom_delay
    clr _CY
    %3:
    ret
} by {
    orl _sfr_b9,#0x80
    anl _P1,#0xdf
    lcall _monitor_eeprom_delay
    clr _eeprom_sda
    lcall _monitor_eeprom_delay
    clr _eeprom_scl
    mov a,_monitor_eeprom_device
    anl a,#0x6f
    rl a
    orl a,#0xa0
    lcall _monitor_eeprom_send_byte
    jc 00973$
    mov a,r0
    lcall _monitor_eeprom_send_byte
    jc 00973$
    lcall _monitor_eeprom_delay
    setb _eeprom_scl
    orl _sfr_b9,#0x80
    anl _P1,#0xdf
    lcall _monitor_eeprom_delay
    clr _eeprom_sda
    lcall _monitor_eeprom_delay
    clr _eeprom_scl
    mov a,_monitor_eeprom_device
    anl a,#0x6f
    rl a
    orl a,#0xa1
    lcall _monitor_eeprom_send_byte
    jc 00973$
    00976$:
    lcall _monitor_eeprom_read_byte
    jb _verify_eeprom_data,00974$
    movx @dptr,a
    sjmp 00975$
    00974$:
    mov _B,a
    movx a,@dptr
    cjne a,_B,00973$
    00975$:
    inc dptr
    djnz r1,00976$
    setb _eeprom_sda
    orl _sfr_b9,#0x80
    orl _P1,#0x20
    lcall _monitor_eeprom_delay
    clr c
    ret
    00973$:
    setb c
    ret
}
