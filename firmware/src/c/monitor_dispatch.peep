    mov _P2,#0xff
    mov _P3,#0xff
    mov _P4,#0x00
    mov _P5,#0x99
    mov _P6,#0xff
    mov _P9,#0x66
    mov _monitor_transfer_bytes,#0xee
    %3:
} by {
    clr _EA
    mov r0,a
