    rrc a
    jnc 00972$
    orl _P9,#0x08
    sjmp 00973$
    00972$:
    anl _P9,#0xf7
    00973$:
    orl _P9,#0x01
    push acc
    mov a,_P9
    mov c,acc.6
    pop acc
    anl _P9,#0xfe
    djnz _B,00974$
    rrc a
    inc r0
    cjne r0,#0x80,00975$
    orl _P9,#0x04
    pop acc
    mov r0,a
}

