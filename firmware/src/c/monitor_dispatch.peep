    mov r6,a
    mov _B,r6
    mov a,r6
    jz %9
    ljmp %1
    %9:
    jb _CY,%10
    ljmp %11
    %10:
    mov r6,#0x80
    ljmp %12
    %11:
    mov r6,#0x00
    %12:
    mov a,_ACC
    anl a,#0x01
    mov r5,a
    mov a,r5
    add a,#0xff
    mov _CY,c
    mov a,_ACC
    clr c
    rrc a
    mov r5,a
    mov a,r6
    orl a,r5
    mov _ACC,a
    inc _stock_r0
    orl _P9,#0x04
    mov _stock_r0,r7
} by {
    00971$:
    mov a,r0
    push acc
    mov r0,#_monitor_transfer_bytes
    anl _P9,#0xfb
    00975$:
    mov a,@r0
    inc r0
    mov @r0,a
