    clr _service_request_seen
    clr a
    mov _output_override_flags,a
    mov _ignition_override,a
    mov _knock_override,a
    mov _output_flags,a
    mov _sensor_override,a
    mov r3,#(_session_stop_reply >> 8)
    mov r4,#_session_stop_reply
