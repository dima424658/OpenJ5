    mov r7,#(_session_stop_reply >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
    mov r0,#_serial_default_reload
    mov @r0,#0xd0
    ljmp %3
    %2:
    mov r6,#_session_stop_inactive_reply
    mov r7,#(_session_stop_inactive_reply >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
