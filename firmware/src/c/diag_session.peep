// Keep the response and the deferred service 11 marker.
replace {
    lcall _reset_serial_transmit_buffer
    jb _service_session_active,%1
    ljmp %2
    %1:
    mov r6,#_service_11_reply
    mov r7,#(_service_11_reply >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
    mov r0,#_serial_rx_state
    mov a,@r0
    orl a,#0x20
    mov @r0,a
    ljmp %3
    %2:
    mov r6,#_service_11_inactive_reply
    mov r7,#(_service_11_inactive_reply >> 8)
    mov _stock_r3,r7
    mov _stock_r4,r6
    lcall _append_code_string_to_serial
