// Send each bit in the original timed slot.
replace {
    mov _B,#0x08
    orl _sfr_b9,#0x80
    anl _P5,#0x7f
    %1:
    nop
    nop
    clr _serial_line
    jb _CY,%2
    ljmp %3
    %2:
    mov r7,#0x80
    ljmp %4
    %3:
    mov r7,#0x00
    %4:
    mov a,_ACC
    anl a,#0x01
    mov r6,a
    mov a,r6
    add a,#0xff
    mov _CY,c
    mov a,_ACC
    clr c
    rrc a
    mov r6,a
    mov a,r7
    orl a,r6
    mov _ACC,a
    nop
    nop
    mov c,_CY
    mov _serial_line,c
    mov r7,_ACC
    mov _ACC,#0x1b
    push ar7
    lcall _monitor_delay_acc
    pop ar7
    mov _ACC,r7
    setb _serial_line
    mov a,_B
    dec a
    mov r7,a
    mov _B,r7
    mov a,r7
    jz %5
    ljmp %1
    %5:
    orl _sfr_b9,#0x80
    orl _P5,#0x80
    %6:
    ret
} by {
    mov _B,#0x08
    orl _sfr_b9,#0x80
    anl _P5,#0x7f
    00975$:
    nop
    nop
    clr _serial_line
    rrc a
    nop
    nop
    mov _serial_line,c
    push acc
    mov a,#0x1b
    lcall _monitor_delay_acc
    pop acc
    setb _serial_line
    djnz _B,00975$
    orl _sfr_b9,#0x80
    orl _P5,#0x80
    ret
}

