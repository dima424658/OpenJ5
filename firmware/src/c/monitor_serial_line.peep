// Advance the staged transfer with the stock timer and error response.
replace {
    mov _monitor_serial_steps,#0x0b
    %1:
    setb _iac_tick_interrupt_enabled
    setb _iac_tick_high_priority
    lcall _step_monitor_serial_block
    jnb _CY,%2
    ljmp %3
    %2:
    mov _TMOD,#0x01
    clr _timer0_running
    mov _TL0,#0xeb
    mov _TH0,#0xcb
    clr _timer0_overflow
    setb _timer0_running
    %4:
    jb _timer0_overflow,%5
    ljmp %4
    %5:
    mov a,_monitor_serial_steps
    jz %6
    ljmp %1
    %6:
    clr _CY
    %3:
    mov _monitor_selected_field,_monitor_serial_steps
    mov c,_CY
    mov _monitor_checksum_failed,c
    clr _monitor_command_active
    setb _monitor_result_ready
    lcall _resume_service_monitor
    %7:
    ret
} by {
    mov _monitor_serial_steps,#0x0b
    00972$:
    setb _iac_tick_interrupt_enabled
    setb _iac_tick_high_priority
    lcall _step_monitor_serial_block
    jc 00970$
    mov _TMOD,#0x01
    clr _timer0_running
    mov _TL0,#0xeb
    mov _TH0,#0xcb
    clr _timer0_overflow
    setb _timer0_running
    00971$:
    jnb _timer0_overflow,00971$
    mov a,_monitor_serial_steps
    jnz 00972$
    clr c
    00970$:
    mov _monitor_selected_field,_monitor_serial_steps
    mov _monitor_checksum_failed,c
    clr _monitor_command_active
    setb _monitor_result_ready
    ljmp _resume_service_monitor
}

