// Clear the eight-byte monitor buffer in register order.
replace {
    mov r6,#_monitor_serial_buffer
    mov r7,#(_monitor_serial_buffer >> 8)
    mov ((_STOCK_DPTR >> 0) & 0xFF),r6
    mov ((_STOCK_DPTR >> 8) & 0xFF),r7
    mov _B,#0x08
    mov _ACC,#0x00
    %1:
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,_ACC
    movx @dptr,a
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    mov a,_B
    dec a
    mov r7,a
    mov _B,r7
    mov a,r7
    jz %2
    ljmp %1
    %2:
    %3:
    ret
} by {
    mov dptr,#_monitor_serial_buffer
    mov _B,#0x08
    clr a
    00979$:
    movx @dptr,a
    inc dptr
    djnz _B,00979$
    ret
}

