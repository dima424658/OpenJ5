// Preserve validation order, receive cursor and byte checksum loop.
replace {
    mov dptr,#(_serial_rx_buffer + 0x0001)
    movx a,@dptr
    mov r7,a
    cjne r7,#0x10,%1
    ljmp %2
    %1:
    mov _ACC,#0x01
    ljmp %3
    %2:
    mov dptr,#_serial_rx_buffer
    movx a,@dptr
    mov r7,a
    anl ar7,#0xc0
    cjne r7,#0x80,%4
    ljmp %5
    %4:
    mov _ACC,#0x02
    ljmp %3
    %5:
    clr c
    mov a,_serial_expected_length
    subb a,_serial_rx_count
    jc %6
    ljmp %7
    %6:
    mov _ACC,#0x04
    ljmp %3
    %7:
    mov _stock_r4,#0x00
    mov r7,_serial_expected_length
    mov a,r7
    dec a
    mov _stock_r3,a
    mov r6,#_serial_rx_buffer
    mov r7,#(_serial_rx_buffer >> 8)
    mov ((_STOCK_DPTR >> 0) & 0xFF),r6
    mov ((_STOCK_DPTR >> 8) & 0xFF),r7
    %8:
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    movx a,@dptr
    mov r7,a
    mov a,r7
    add a, _stock_r4
    mov _stock_r4,a
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    mov a,_stock_r3
    dec a
    mov r7,a
    mov _stock_r3,r7
    mov a,r7
    jz %9
    ljmp %8
    %9:
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    movx a,@dptr
    mov r7,a
    mov a,r7
    cjne a,_stock_r4,%10
    sjmp %11
    %10:
    ljmp %12
    %11:
    mov r7,#0x00
    ljmp %13
    %12:
    mov r7,#0x08
    %13:
    mov _ACC,r7
    %3:
    mov r0,#_serial_rx_state
    mov @r0,_ACC
    %14:
    ret
} by {
    mov dptr,#(_serial_rx_buffer + 1)
    movx a,@dptr
    xrl a,#0x10
    jz 00970$
    clr a
    orl a,#0x01
    sjmp 00971$
    00970$:
    mov dptr,#_serial_rx_buffer
    movx a,@dptr
    anl a,#0xc0
    xrl a,#0x80
    jz 00972$
    clr a
    orl a,#0x02
    sjmp 00971$
    00972$:
    mov r0,#_serial_expected_length
    mov a,_serial_rx_count
    setb c
    subb a,@r0
    jc 00973$
    clr a
    orl a,#0x04
    sjmp 00971$
    00973$:
    mov r4,#0x00
    mov a,@r0
    dec a
    mov r3,a
    mov dptr,#_serial_rx_buffer
    00974$:
    movx a,@dptr
    add a,r4
    mov r4,a
    inc dptr
    djnz r3,00974$
    movx a,@dptr
    xrl a,r4
    jz 00971$
    clr a
    orl a,#0x08
    00971$:
    mov r0,#_serial_rx_state
    mov @r0,a
    ret
}

// Select the service byte for either diagnostic header form.
replace {
    mov dptr,#(_serial_rx_buffer + 0x0002)
    mov r0,#_serial_response_address
    movx a,@dptr
    mov @r0,a
    jb _serial_extended_length,%1
    ljmp %2
    %1:
    mov dptr,#(_serial_rx_buffer + 0x0004)
    movx a,@dptr
    mov r7,a
    ljmp %3
    %2:
    mov dptr,#(_serial_rx_buffer + 0x0003)
    movx a,@dptr
    mov r7,a
    %3:
    mov r0,#_serial_request_service
    mov @r0,ar7
    mov r0,#_serial_rx_state
    mov a,@r0
    jnz %4
    ljmp %5
    %4:
    lcall _respond_to_frame_error
    ljmp %6
    %5:
    lcall _dispatch_valid_service_frame
    %6:
    ret
} by {
    mov dptr,#(_serial_rx_buffer + 2)
    movx a,@dptr
    mov r0,#_serial_response_address
    mov @r0,a
    jnb _serial_extended_length,00975$
    mov dptr,#(_serial_rx_buffer + 4)
    movx a,@dptr
    mov r0,#_serial_request_service
    mov @r0,a
    sjmp 00976$
    00975$:
    mov dptr,#(_serial_rx_buffer + 3)
    movx a,@dptr
    mov r0,#_serial_request_service
    mov @r0,a
    00976$:
    mov r0,#_serial_rx_state
    mov a,@r0
    jz 00977$
    lcall _respond_to_frame_error
    sjmp 00978$
    00977$:
    lcall _dispatch_valid_service_frame
    00978$:
    ret
}

// Keep the negative response and error recovery paths in the original frame slot.
replace {
    mov r0,#_serial_rx_state
    mov acc,@r0
    anl a,#0x03
    jnz %1
    ljmp %2
    %1:
    lcall _restart_serial_receive
    ljmp %3
    %2:
    mov r0,#_serial_rx_state
    mov acc,@r0
    jb acc.2,%4
    ljmp %5
    %4:
    mov r7,#0x31
    ljmp %6
    %5:
    mov r7,#0x77
    %6:
    mov _stock_r3,r7
    jb _service_inhibit_69,%7
    ljmp %8
    %7:
    lcall _build_serial_probe_status
    ljmp %3
    %8:
    jb _service_session_active,%9
    ljmp %10
    %9:
    lcall _reset_serial_transmit_buffer
    mov r6,#_serial_tx_buffer
    mov r7,#(_serial_tx_buffer >> 8)
    mov ((_STOCK_DPTR >> 0) & 0xFF),r6
    mov ((_STOCK_DPTR >> 8) & 0xFF),r7
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,#0x83
    movx @dptr,a
    mov _stock_r4,a
    mov r0,#_serial_response_address
    mov _respond_to_frame_error_fields_40001_30,@r0
    mov (_respond_to_frame_error_fields_40001_30 + 0x0001),#0x10
    mov (_respond_to_frame_error_fields_40001_30 + 0x0002),#0x7f
    mov r0,#_serial_request_service
    mov (_respond_to_frame_error_fields_40001_30 + 0x0003),@r0
    mov (_respond_to_frame_error_fields_40001_30 + 0x0004),_stock_r3
    mov r7,#0x00
    %11:
    cjne r7,#0x05,%12
    %12:
    jc %13
    ljmp %14
    %13:
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,r7
    add a, #_respond_to_frame_error_fields_40001_30
    mov r1,a
    mov ar6,@r1
    mov a,r6
    movx @dptr,a
    cjne r7,#0x04,%15
    %15:
    jc %16
    ljmp %17
    %16:
    mov ar6,@r1
    mov a,r6
    add a, _stock_r4
    mov _stock_r4,a
    %17:
    inc r7
    ljmp %11
    %14:
    mov a,_stock_r3
    add a, _stock_r4
    mov _ACC,a
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,_ACC
    movx @dptr,a
    mov _serial_tx_count,#0x07
    setb _service_dispatch_7c
    ljmp %3
    %10:
    lcall _restart_serial_receive
    %3:
    ret
} by {
    mov r0,#_serial_rx_state
    mov acc,@r0
    jnb acc.0,00979$
    sjmp 00980$
    00979$:
    jnb acc.1,00981$
    sjmp 00980$
    00981$:
    jnb acc.2,00982$
    mov r3,#0x31
    sjmp 00983$
    00982$:
    mov r3,#0x77
    00983$:
    jnb _service_inhibit_69,00984$
    lcall _build_serial_probe_status
    sjmp 00985$
    00984$:
    jnb _service_session_active,00980$
    lcall _reset_serial_transmit_buffer
    mov dptr,#_serial_tx_buffer
    mov a,#0x83
    movx @dptr,a
    mov r4,a
    mov r0,#_serial_response_address
    mov a,@r0
    inc dptr
    movx @dptr,a
    add a,r4
    mov r4,a
    inc dptr
    mov a,#0x10
    movx @dptr,a
    add a,r4
    mov r4,a
    inc dptr
    mov a,#0x7f
    movx @dptr,a
    add a,r4
    mov r4,a
    mov r0,#_serial_request_service
    mov a,@r0
    inc dptr
    movx @dptr,a
    add a,r4
    mov r4,a
    mov a,r3
    inc dptr
    movx @dptr,a
    add a,r4
    inc dptr
    movx @dptr,a
    mov _serial_tx_count,#0x07
    setb _service_dispatch_7c
    sjmp 00985$
    00980$:
    lcall _restart_serial_receive
    00985$:
    ret
}

// Reset the receive buffer and resume UART reception.
replace {
    anl _serial_control_be,#0xf7
    clr _service_event_pending
    lcall _reset_serial_receive_buffer
    mov r0,#_serial_rx_state
    mov @r0,#0x00
    setb _serial_receive_enabled
    %1:
    ret
} by {
    anl _serial_control_be,#0xf7
    clr _service_event_pending
    lcall _reset_serial_receive_buffer
    mov r0,#_serial_rx_state
    mov @r0,#0x00
    setb _serial_receive_enabled
    ret
}
