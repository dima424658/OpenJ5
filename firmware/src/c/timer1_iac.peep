// Pair the ADC retry with the stock two-page lookup and atomic sum update.
replace {
    clr _adc_interrupted_by_iac
    %1:
    mov _adc_channel,#0x00
    mov _adc_start,#0x00
    %2:
    jnb _adc_busy,%3
    ljmp %2
    %3:
    mov r7,_adc_result_high
    jb _adc_interrupted_by_iac,%4
    ljmp %5
    %4:
    clr _adc_interrupted_by_iac
    ljmp %1
    %5:
    setb _adc_interrupted_by_iac
    mov dptr,#_maf_adc_sample
    mov a,r7
    movx @dptr,a
    mov a,r7
    add a, #_maf_transfer_raw
    mov dpl,a
    mov a,#0x00
    addc a, #(_maf_transfer_raw >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r6,a
    clr _interrupts_enabled
    mov a,r7
    add a, #_maf_transfer_high
    mov dpl,a
    mov a,#0x00
    addc a, #(_maf_transfer_high >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov r5,#0x00
    mov ar5,r7
    mov r7,#0x00
    mov r4,#0x00
    mov a,r6
    orl ar7,a
    mov a,r4
    orl ar5,a
    mov a,r7
    add a, _airflow_sample_sum
    mov r4,a
    mov a,r5
    addc a, (_airflow_sample_sum + 1)
    mov r6,a
    clr c
    mov a,r4
    subb a,r7
    mov a,r6
    subb a,r5
    jnc %6
    ljmp %7
    %6:
    mov _airflow_sample_sum,r4
    mov (_airflow_sample_sum + 1),r6
    mov a,#0xff
    cjne a,_airflow_sample_count,%8
    ljmp %7
    %8:
    inc _airflow_sample_count
    %7:
    setb _interrupts_enabled
    lcall _service_multispark_and_speed
    %9:
    ret
} by {
    clr _adc_interrupted_by_iac
    00988$:
    mov _adc_channel,#0x00
    mov _adc_start,#0x00
    00987$:
    jb _adc_busy,00987$
    mov a,_adc_result_high
    jbc _adc_interrupted_by_iac,00988$
    setb _adc_interrupted_by_iac
    mov dptr,#_maf_adc_sample
    movx @dptr,a
    mov b,a
    mov dptr,#_maf_transfer_raw
    movc a,@a+dptr
    clr c
    clr _interrupts_enabled
    add a,_airflow_sample_sum
    xch a,b
    inc dph
    movc a,@a+dptr
    addc a,0x31
    jnc 00989$
    sjmp 00990$
    00989$:
    mov _airflow_sample_sum,b
    mov 0x31,a
    mov a,_airflow_sample_count
    inc a
    jz 00990$
    mov _airflow_sample_count,a
    00990$:
    setb _interrupts_enabled
}
