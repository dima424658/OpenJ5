// Choose adaptation or detection, preserving the temperature and hold-count gates.
replace {
    jnb _noise_adaptation_active,%1
    ljmp %2
    %1:
    lcall _detect_knock_event
    ljmp %3
    %2:
    mov dptr,#_knock_noise_adaptation_temp
    clr a
    movc a,@a+dptr
    mov r7,a
    clr c
    mov a,r7
    subb a,_coolant_temperature_raw
    jc %4
    ljmp %5
    %4:
    mov dptr,#_knock_noise_hold_count
    movx a,@dptr
    mov r7,a
    cjne r7,#0x05,%6
    %6:
    jnc %7
    ljmp %8
    %7:
    %5:
    lcall _finish_knock_sample
    ljmp %3
    %8:
    lcall _adapt_knock_noise_reference
    %3:
    ret
} by {
    jnb _noise_adaptation_active,00940$
    mov dptr,#_knock_noise_adaptation_temp
    clr a
    movc a,@a+dptr
    cjne a,_coolant_temperature_raw,00941$
    00941$:
    jnc 00942$
    mov dptr,#_knock_noise_hold_count
    movx a,@dptr
    cjne a,#0x05,00943$
    00943$:
    jc _adapt_knock_noise_reference
    00942$:
    ljmp _finish_knock_sample
    00940$:
    ljmp _detect_knock_event
}

// Apply the stock sample floor, call the filter, and publish both copies of the noise reference.
replace {
    mov a,_stock_r4
    clr c
    rrc a
    mov _stock_r0,a
    mov dptr,#_knock_average_noise
    movx a,@dptr
    mov _stock_r3,a
    clr c
    mov a,_stock_r3
    subb a,_bank_one_noise_floor
    jc %1
    ljmp %2
    %1:
    mov a,_stock_r3
    rl a
    mov _stock_r4,a
    mov a,_stock_r3
    %2:
    mov dptr,#_knock_noise_accumulator
    movx a,@dptr
    mov r6,a
    inc dptr
    movx a,@dptr
    mov r7,a
    mov _stock_r1,r6
    mov _stock_r2,r7
    mov dptr,#_knock_noise_filter_coefficient
    clr a
    movc a,@a+dptr
    mov _B,a
    mov _ACC,_stock_r4
    lcall _filter_knock_noise
    mov dptr,#_knock_average_noise
    mov a,_ACC
    movx @dptr,a
    mov dptr,#_retained_knock_noise
    mov a,_ACC
    movx @dptr,a
    mov r6,_stock_r2
    mov r7,#0x00
    mov ar7,r6
    mov r6,#0x00
    mov r4,_stock_r1
    mov r5,#0x00
    mov dptr,#_knock_noise_accumulator
    mov a,r4
    orl a,r6
    movx @dptr,a
    mov a,r5
    orl a,r7
    inc dptr
    movx @dptr,a
    lcall _adjust_knock_attenuation
    lcall _diagnose_knock_noise_range
} by {
    mov a,r4
    clr c
    rrc a
    mov r0,a
    mov dptr,#_knock_average_noise
    movx a,@dptr
    mov r3,a
    cjne a,_bank_one_noise_floor,00944$
    00944$:
    jnc 00945$
    rl a
    mov r4,a
    00945$:
    mov dptr,#_knock_noise_accumulator
    movx a,@dptr
    mov r1,a
    inc dpl
    movx a,@dptr
    mov r2,a
    mov dptr,#_knock_noise_filter_coefficient
    clr a
    movc a,@a+dptr
    mov _B,a
    mov a,r4
    lcall _filter_knock_noise
    mov dptr,#_knock_average_noise
    movx @dptr,a
    mov dptr,#_retained_knock_noise
    movx @dptr,a
    mov dptr,#_knock_noise_accumulator
    mov a,r1
    movx @dptr,a
    inc dpl
    mov a,r2
    movx @dptr,a
    lcall _adjust_knock_attenuation
    lcall _diagnose_knock_noise_range
}

// Normalize the noise for map lookup and scale the threshold in Q4 with saturation.
replace {
    mov a,_knock_attenuation
    swap a
    rl a
    anl a,#0x1f
    mov r7,a
    anl ar7,#0x03
    cjne r7,#0x01,%1
    sjmp %2
    %1:
    ljmp %3
    %2:
