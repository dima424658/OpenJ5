    mov r6,_B
    mov b,r7
    mov a,r6
    mul ab
    mov r7,a
    mov r5,b
    mov ar4,r7
    mov ar6,r5
    clr c
    mov a,#0xff
    subb a,r4
    mov a,#0x00
    subb a,r6
    jc %8
    ljmp %9
    %8:
    mov r4,#0xff
