} by {
    mov a,_knock_attenuation
    rr a
    rr a
    rr a
    anl a,#0x03
    cjne a,#0x01,00946$
    mov a,#0x02
    sjmp 00947$
    00946$:
    jnc 00948$
    mov a,#0x01
    sjmp 00947$
    00948$:
    mov a,#0x04
    00947$:
    mov _B,a
    mov dptr,#_retained_knock_noise
    movx a,@dptr
    mul ab
    mov r0,a
    mov a,_B
    jz 00949$
    mov r0,#0xff
    00949$:
    mov a,r0
    mov dptr,#_normalized_knock_noise
    movx @dptr,a
    swap a
    rl a
    anl a,#0x1f
    mov dptr,#_knock_noise_bin
    movx @dptr,a
    mov dptr,#_knock_relative_threshold_q4
    movc a,@a+dptr
