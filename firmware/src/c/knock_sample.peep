// Preserve the absolute threshold and borrow-sensitive relative test before posting the event.
replace {
    mov dptr,#_knock_noise_hold_count
    mov a,#0x00
    movx @dptr,a
    mov dptr,#_knock_absolute_threshold
    movx a,@dptr
    mov r7,a
    clr c
    mov a,_stock_r1
    subb a,r7
    jc %1
    ljmp %2
    %1:
    clr c
    mov a,_stock_r3
    subb a,_stock_r1
    jc %3
    ljmp %4
    %3:
    mov r7,_stock_r1
    mov r6,_knock_noise_threshold
    anl ar6,#0x01
    mov r5,#0x00
    mov r4,#0x00
    mov a,r6
    add a, r7
    mov r7,a
    mov a,r4
    addc a, r5
    mov r5,a
    mov a,_knock_noise_threshold
    clr c
    rrc a
    mov r6,a
    clr c
    mov a,r6
    subb a,r7
    mov a,r4
    subb a,r5
    jc %5
    ljmp %4
    %5:
    %2:
    mov _stock_r1,_knock_mask_index
    mov a,_stock_r1
    add a, #_knock_event_masks
    mov dpl,a
    mov a,#0x00
    addc a, #(_knock_event_masks >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov r7,a
    mov a,r7
    orl _pending_knock_mask,a
    %4:
    lcall _finish_knock_sample
    %6:
    ret
} by {
    clr a
    mov dptr,#_knock_noise_hold_count
    movx @dptr,a
    mov dptr,#_knock_absolute_threshold
    movx a,@dptr
    setb c
    subb a,r1
    jc 00952$
    mov a,r3
    subb a,r1
    jc 00953$
    sjmp _finish_knock_sample
    00953$:
    mov a,_knock_noise_threshold
    clr c
    rrc a
    subb a,r1
    jnc _finish_knock_sample
    00952$:
    mov r1,_knock_mask_index
    mov dptr,#_knock_event_masks
    mov a,r1
    movc a,@a+dptr
    orl _pending_knock_mask,a
}
