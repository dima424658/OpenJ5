    mov a,_stock_r0
    movx @dptr,a
    mov a,_stock_r0
    swap a
    rl a
    anl a,#0x1f
    mov _ACC,a
    mov dptr,#_knock_noise_bin
    mov a,_ACC
    movx @dptr,a
    mov a,_ACC
    add a, #_knock_relative_threshold_q4
    mov dpl,a
    mov a,#0x00
    addc a, #(_knock_relative_threshold_q4 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    mov dptr,#_retained_knock_noise
    movx a,@dptr
    mov r7,a
    mov r6,_B
    mov b,r7
    mov a,r6
    mul ab
    mov r7,a
    mov r5,b
    mov a,r5
    swap a
    xch a,r7
    swap a
    anl a,#0x0f
    xrl a,r7
    xch a,r7
    anl a,#0x0f
    xch a,r7
    xrl a,r7
    xch a,r7
    mov r6,a
    mov ar4,r7
    mov ar5,r6
    clr c
    mov a,#0xff
    subb a,r4
    mov a,#0x00
    subb a,r5
    jc %11
    ljmp %12
    %11:
    mov r4,#0xff
    mov r5,#0x00
    ljmp %13
    %12:
    mov ar4,r7
    mov ar5,r6
    %13:
    mov _knock_noise_threshold,r4
    lcall _finish_knock_sample
    %14:
