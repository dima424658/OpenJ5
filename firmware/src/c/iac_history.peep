// The entire fixed XDATA range is in page F8. Keep the cursor in DPTR,
// use its low byte for stepping and leave zero in A throughout the loop.
replace {
    mov r6,#_iac_history
    mov r7,#(_iac_history >> 8)
    mov r5,#0x0a
    %1:
    mov dpl,r6
    mov dph,r7
    mov a,#0x00
    movx @dptr,a
    inc dptr
    mov r6,dpl
    mov r7,dph
    dec r5
    mov a,r5
    jz %2
    ljmp %1
    %2:
} by {
    clr a
    mov dptr,#_iac_history
    mov r1,#0x0a
    %1:
    movx @dptr,a
    inc dpl
    djnz r1,%1
    %2:
}
