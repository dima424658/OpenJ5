// Keep a CODE table's base in DPTR and its byte offset in A.
replace {
    mov a,%1
    add a,#%2
    mov dpl,a
    mov a,#0x00
    addc a,#(%2 >> 8)
    mov dph,a
    clr a
    movc a,@a+dptr
} by {
    mov dptr,#%2
    mov a,%1
    movc a,@a+dptr
}

// B holds the temperature correction and R1 holds the adjusted base angle.
replace {
    mov r7,a
    mov dptr,#_idle_ignition_by_rpm
    mov a,_rpm_nearest_half_bin
    movc a,@a+dptr
    mov r6,a
    mov a,r6
    clr c
    subb a,r7
    mov r7,a
} by {
    mov b,a
    mov dptr,#_idle_ignition_by_rpm
    mov a,_rpm_nearest_half_bin
    movc a,@a+dptr
    clr c
    subb a,b
    mov r1,a
}

// Only the borrow is needed from the unsigned time comparison.
// CJNE to the next instruction preserves A and supplies that borrow in CY.
replace {
    mov dptr,#_warmup_duration
    movx a,@dptr
    mov %4,a
    mov dptr,#_warmup_elapsed
    movx a,@dptr
    mov %5,a
    clr c
    mov a,%5
    subb a,%4
    jnc %1
    ljmp %2
    %1:
    mov %4,#0x00
    ljmp %3
} by {
    mov dptr,#_warmup_duration
    movx a,@dptr
    mov b,a
    mov dptr,#_warmup_elapsed
    movx a,@dptr
    cjne a,b,%1
    %1:
    jc %2
    clr a
    sjmp %3
}

// Both branches leave the warmup correction in A for addition to R1.
replace {
    movc a,@a+dptr
    mov r6,a
    %1:
    mov a,r6
    add a,r7
    mov _idle_ignition_target_raw,a
} by {
    movc a,@a+dptr
    %1:
    add a,r1
    mov _idle_ignition_target_raw,a
}

// XDATA stores take the byte directly from the accumulator.
replace {
    mov r7,a
    mov dptr,#_warmup_duration
    mov a,r7
    movx @dptr,a
} by {
    mov dptr,#_warmup_duration
    movx @dptr,a
}

// Load the multiplicands into B and A, then form the product in B:A.
replace {
    mov r6,a
    mov dptr,#_warmup_ignition_weight_raw
    mov a,_operating_point_index
    movc a,@a+dptr
    mov r5,a
    mov b,r6
    mov a,r5
    mul ab
} by {
    mov b,a
    mov dptr,#_warmup_ignition_weight_raw
    mov a,_operating_point_index
    movc a,@a+dptr
    mul ab
}

// Adding 128 rounds the product before discarding the low byte.
replace {
    mov r6,a
    mov r4,b
    mov a,#%1
    add a,r6
    mov r6,a
    mov a,#0x00
    addc a,r4
    mov r4,a
    mov ar7,r4
    %2:
    mov dptr,#_load_warmup_correction_raw
    mov a,r7
    movx @dptr,a
} by {
    add a,#%1
    mov a,b
    addc a,#0x00
    %2:
    mov dptr,#_load_warmup_correction_raw
    movx @dptr,a
}

// The original routine continues immediately after the linked C block.
replace {
    lcall _idle_ignition_continue
    %1:
    ret
} by {
    %1:
}

replace {
    lcall _warmup_setup_continue
    %1:
    ret
} by {
    %1:
}

replace {
    lcall _load_ignition_continue
    %1:
    ret
} by {
    %1:
}
