// Preserve the compare interrupt and schedule the next synthetic tooth.
replace {
    mov r6,_crank_capture_low
    mov r7,#0x00
    mov r4,_crank_capture_high
    mov r5,#0x00
    mov ar5,r4
    mov r4,#0x00
    mov a,r4
    orl a,r6
    mov _last_crank_capture,a
    mov a,r5
    orl a,r7
    mov (_last_crank_capture + 1),a
    mov a,#0x39
    cjne a,_crank_tooth,%1
    sjmp %2
    %1:
    ljmp %3
    %2:
    mov a,_previous_tooth_period
    add a, _last_crank_capture
    mov r6,a
    mov a,(_previous_tooth_period + 1)
    addc a, (_last_crank_capture + 1)
    mov r7,a
    mov _crank_capture_low,r6
    mov _crank_capture_high,r7
    clr _capture_compare_pending
    inc _crank_tooth
    mov _half_turn_tooth,#0x1c
    ljmp %4
    %3:
    clr _crank_gap_compare_active
    mov a,_capture_compare_control
    anl a,#0x3f
    orl a,#0x40
    mov _capture_compare_control,a
    inc _crank_tooth
    mov _half_turn_tooth,#0x1d
    %4:
    lcall _dispatch_crank_tooth_event
    %5:
} by {
    mov r2,_crank_capture_low
    mov r3,_crank_capture_high
    cjne r6,#0x39,00970$
    mov a,r2
    add a,r4
    mov _crank_capture_low,a
    mov a,r3
    addc a,r5
    mov _crank_capture_high,a
    clr _capture_compare_pending
    inc r6
    mov r7,#0x1c
    ljmp _dispatch_crank_tooth_event
    00970$:
    clr _crank_gap_compare_active
    anl _capture_compare_control,#0x3f
    orl _capture_compare_control,#0x40
    inc r6
    mov r7,#0x1d
    ljmp _dispatch_crank_tooth_event
}

// Use the common synchronization-loss branch.
replace {
    lcall _mark_crank_sync_lost
    %1:
    ret
} by {
    ljmp _mark_crank_sync_lost
}

// Keep the short branch to the common reset path after noting a tooth event.
replace {
    setb _crank_event
    lcall _reset_crank_capture_state
    %1:
    ret
} by {
    setb _crank_event
    ljmp _reset_crank_capture_state
}

// Retain the direct interrupt exit entry.
replace {
    lcall _irq_crank_reti
    %1:
    ret
} by {
    ljmp _irq_crank_reti
}

