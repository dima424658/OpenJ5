// Clear the sync state and both pending half-turn flags before restoring the context.
replace {
    setb _crank_sync_lost
    lcall _reset_crank_capture_state
    %1:
    ret
} by {
    setb _crank_sync_lost
}

// Tail into the hand-written register restoration.
replace {
    mov _crank_sync_state,#0x00
    clr _pending_half_turn_a
    clr _pending_half_turn_b
    lcall _irq_crank_epilogue
    %1:
    ret
} by {
    mov _crank_sync_state,#0x00
    clr _pending_half_turn_a
    clr _pending_half_turn_b
    ljmp _irq_crank_epilogue
}
