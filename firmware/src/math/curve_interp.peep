// Keep the caller's CODE base in DPTR. MOVC adds the byte from A itself.
replace {
    mov r6,((_STOCK_DPTR >> 0) & 0xFF)
    mov r7,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,_stock_r2
    add a,r6
    mov dpl,a
    mov a,#0x00
    addc a,r7
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r0,a
} by {
    mov a,r2
    movc a,@a+dptr
    mov r0,a
}

replace {
    mov r5,_stock_r2
    inc r5
    mov a,r5
    add a,r6
    mov dpl,a
    mov a,#0x00
    addc a,r7
    mov dph,a
    clr a
    movc a,@a+dptr
} by {
    mov a,r2
    inc a
    movc a,@a+dptr
}

// As the operands are unsigned bytes, the sign of their widened difference
// is exactly the borrow from the low-byte subtraction.
replace {
    mov r7,a
    mov r6,_stock_r0
    mov ar4,r6
    mov r5,#0x00
    mov r3,#0x00
    mov a,r7
    clr c
    subb a,r4
    mov r4,a
    mov a,r3
    subb a,r5
    mov r5,a
    mov ar3,r4
    mov ar7,r5
    mov a,r7
    jnb acc.7,%1
    ljmp %2
    %1:
} by {
    clr c
    subb a,r0
    jc %2
    %1:
}

// The nonnegative difference is already in A. Load the weight into B.
replace {
    mov ar7,r4
    mov r3,_stock_r3
    mov b,r7
    mov a,r3
    mul ab
} by {
    mov b,r3
    mul ab
}

// Fold rounding and addition of the left node into the high product byte.
replace {
    mov r7,a
    mov r2,b
    mov a,#0x80
    add a,r7
    mov r7,a
    mov a,#0x00
    addc a,r2
    mov r2,a
    mov ar7,r2
    mov a,r7
    add a,r6
    mov _ACC,a
    ljmp %1
} by {
    add a,#0x80
    mov a,b
    addc a,r0
    sjmp %1
}

// For a negative difference, negate the low byte modulo 256.
replace {
    clr c
    clr a
    subb a,r4
    mov r4,a
    mov r7,_stock_r3
    mov b,r4
    mov a,r7
    mul ab
} by {
    cpl a
    inc a
    mov b,r3
    mul ab
}

// Subtract the truncated high byte of the product from the left node.
replace {
    mov r4,a
    mov r5,b
    mov ar4,r5
    mov a,r6
    clr c
    subb a,r4
    mov _ACC,a
} by {
    clr c
    mov a,r0
    subb a,b
}

// Form the first product with the wrapped complementary weight in A.
replace {
    mov r7,_stock_r3
    clr c
    clr a
    subb a,r7
    mov r6,a
    mov r5,_stock_r0
    mov b,r6
    mov a,r5
    mul ab
    mov r6,a
    mov r4,b
    mov _stock_r01,r6
    mov (_stock_r01 + 1),r4
} by {
    mov a,r3
    cpl a
    inc a
    mov b,r0
    mul ab
    mov r0,a
    mov r1,b
}

// Form the second product from the unmodified weight and right sample.
replace {
    mov r6,_stock_r2
    mov b,r7
    mov a,r6
    mul ab
} by {
    mov a,r3
    mov b,r2
    mul ab
}

// Keep the high byte of the sum, including the carry out of its low byte.
replace {
    mov r7,a
    mov r5,b
    mov a,r7
    add a,_stock_r01
    mov r7,a
    mov a,r5
    addc a,(_stock_r01 + 1)
    mov r5,a
    mov _ACC,r5
} by {
    add a,r0
    mov a,b
    addc a,r1
}
