// Update the two bytes in one DPTR page and propagate the low-byte carry.
replace {
    mov _B,_ACC
    mov r6,((_STOCK_DPTR >> 0) & 0xFF)
    mov r7,((_STOCK_DPTR >> 8) & 0xFF)
    mov dpl,r6
    mov dph,r7
    movx a,@dptr
    mov r5,a
    mov r4,_B
    mov r3,#0x00
    mov r2,#0x00
    mov a,r4
    add a, r5
    mov r5,a
    mov a,r2
    addc a, r3
    mov r3,a
    mov ar4,r5
    mov dpl,r6
    mov dph,r7
    mov a,r4
    movx @dptr,a
    inc _STOCK_DPL
    mov r6,((_STOCK_DPTR >> 0) & 0xFF)
    mov r7,((_STOCK_DPTR >> 8) & 0xFF)
    mov dpl,r6
    mov dph,r7
    movx a,@dptr
    mov r4,a
    mov ar5,r3
    mov a,r5
    add a, r4
    mov _ACC,a
    mov dpl,r6
    mov dph,r7
    mov a,_ACC
    movx @dptr,a
    %1:
    ret
} by {
    mov _B,a
    movx a,@dptr
    add a,_B
    movx @dptr,a
    inc dpl
    movx a,@dptr
    addc a,#0x00
    movx @dptr,a
    ret
}

// Read the Q4.4 curve through DPTR and clamp after subtracting the stock bias.
replace {
    mov _stock_r1,_ACC
    mov r6,((_STOCK_DPTR >> 0) & 0xFF)
    mov r7,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,_ACC
    swap a
    anl a,#0x0f
    mov _B,a
    mov a,_B
    add a, r6
    mov dpl,a
    mov a,#0x00
    addc a, r7
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _stock_r0,a
    mov r4,_B
    mov r5,#0x00
    inc r4
    cjne r4,#0x00,%1
    inc r5
    %1:
    mov a,r4
    add a, r6
    mov dpl,a
    mov a,r5
    addc a, r7
    mov dph,a
    clr a
    movc a,@a+dptr
    mov _B,a
    mov a,_stock_r0
    clr c
    subb a,_B
    mov _B,a
    mov r7,_stock_r1
    anl ar7,#0x0f
    mov a,r7
    swap a
    anl a,#0xf0
    mov _ACC,a
    mov r7,_ACC
    mov r6,_B
    mov b,r7
    mov a,r6
    mul ab
    mov r7,a
    mov r5,b
    mov _B,r5
    mov a,_stock_r0
    clr c
    subb a,_B
    mov r7,a
    cjne r7,#0x14,%2
    %2:
    jnc %3
    ljmp %4
    %3:
    mov a,r7
    add a,#0xec
    mov r7,a
    mov ar6,r7
    mov a,r7
    rlc a
    subb a,acc
    mov r7,a
    ljmp %5
    %4:
    mov r6,#0x00
    mov r7,#0x00
    %5:
    mov _ACC,r6
    %6:
    ret
} by {
    mov r1,a
    swap a
    anl a,#0x0f
    mov _B,a
    movc a,@a+dptr
    mov r0,a
    mov a,_B
    inc a
    movc a,@a+dptr
    mov _B,a
    mov a,r0
    clr c
    subb a,_B
    mov _B,a
    mov a,r1
    anl a,#0x0f
    swap a
    mul ab
    mov a,r0
    clr c
    subb a,_B
    clr c
    subb a,#0x14
    jnc 00970$
    mov a,#0x00
    00970$:
    ret
}
