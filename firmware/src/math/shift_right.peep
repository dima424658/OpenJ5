// In the one-bit case, write the shifted high byte before loading the low byte.
replace {
    mov a,(_stock_r01 + 1)
    clr c
    rrc a
    xch a,_stock_r01
    rrc a
    xch a,_stock_r01
    mov (_stock_r01 + 1),a
} by {
    clr c
    mov a,r1
    rrc a
    mov r1,a
    mov a,r0
    rrc a
    mov r0,a
}

// Keep the high byte in A, the low byte in R0 and the count in R1.
// DJNZ decrements the count while preserving the carry from RRC.
replace {
    mov r6,_stock_r01
    mov r7,(_stock_r01 + 1)
    mov r5,#%1
    %2:
    mov a,r7
    clr c
    rrc a
    xch a,r6
    rrc a
    xch a,r6
    mov r7,a
    dec r5
    mov a,r5
    jz %3
    ljmp %2
    %3:
    mov _stock_r01,r6
    mov (_stock_r01 + 1),r7
} by {
    mov a,r1
    mov r1,#%1
    %2:
    clr c
    rrc a
    xch a,r0
    rrc a
    xch a,r0
    djnz r1,%2
    %3:
    mov r1,a
}
