// Take each port sample before loading its XDATA destination.
replace {
    mov dptr,#_port1_snapshot
    mov a,_P1
    movx @dptr,a
    mov dptr,#_sfr_f8_snapshot
    mov a,_sfr_f8
    movx @dptr,a
    mov dptr,#_sfr_fa_snapshot
    mov a,_sfr_fa
    movx @dptr,a
    mov dptr,#_sfr_dd_snapshot
    mov a,_sfr_dd
    movx @dptr,a
} by {
    mov a,_P1
    mov dptr,#_port1_snapshot
    movx @dptr,a
    mov a,_sfr_f8
    mov dptr,#_sfr_f8_snapshot
    movx @dptr,a
    mov a,_sfr_fa
    mov dptr,#_sfr_fa_snapshot
    movx @dptr,a
    mov a,_sfr_dd
    mov dptr,#_sfr_dd_snapshot
    movx @dptr,a
}

// Skip the injector port block in the running fuel mode.
replace {
    jnb _fuel_mode_flag_56,%1
    ljmp %2
    %1:
} by {
    jb _fuel_mode_flag_56,00970$
}

// Apply injector 1 phase and share the delay decrement.
replace {
    mov a,_output_flags_7c
    jb acc.0,%1
    ljmp %2
    %1:
    mov c,_injector_phase_1
    mov _injector_output_1,c
    jnb _injector_phase_1,%3
    ljmp %4
    %3:
    mov dptr,#_injector_test_delay
    movx a,@dptr
    mov r7,a
    mov ar6,r7
    mov a,r7
    jnz %5
    ljmp %6
    %5:
    mov a,r6
    dec a
    mov dptr,#_injector_test_delay
    movx @dptr,a
    ljmp %4
    %6:
    setb _injector_phase_1
    anl _output_flags_7c,#0xf0
    ljmp %4
    %2:
} by {
    mov a,_output_flags_7c
    anl a,#0x01
    jz 00971$
    mov c,_injector_phase_1
    mov _injector_output_1,c
    jb _injector_phase_1,00970$
    mov dptr,#_injector_test_delay
    movx a,@dptr
    jnz 00975$
    setb _injector_phase_1
    anl _output_flags_7c,#0xf0
    sjmp 00970$

    00975$:
    dec a
    movx @dptr,a
    sjmp 00970$
    00971$:
}

// Apply injector 2 phase and share the delay decrement.
replace {
    mov a,_output_flags_7c
    jb acc.1,%1
    ljmp %2
    %1:
    mov c,_injector_phase_2
