// Apply injector 4 phase and share the delay decrement.
replace {
    mov a,_output_flags_7c
    jb acc.3,%1
    ljmp %2
    %1:
    mov c,_injector_phase_4
    mov _injector_output_4,c
    jnb _injector_phase_4,%3
    ljmp %2
    %3:
    mov dptr,#_injector_test_delay
    movx a,@dptr
    mov r7,a
    mov ar6,r7
    mov a,r7
