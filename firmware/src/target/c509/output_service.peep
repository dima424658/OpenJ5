// Keep the conditional driver call and fall through to the next control calculation.
replace {
    jnb _service_inhibit_69,%1
    ljmp %2
    %1:
    lcall _update_relay_outputs
    %2:
    lcall _continue_after_output_service
    %3:
    ret
} by {
    jb _service_inhibit_69,00976$
    lcall _update_relay_outputs
    00976$:
}

// Set the transmitted bit after reading the port and sample its stock input bit.
replace {
    orl _driver_bus_f9,#0x01
    mov _ACC,_driver_bus_f9
    mov c,%40
    mov _ACC_DATA_OUT,c
    mov _driver_bus_f9,_ACC
    mov c,_ACC_DATA_IN
    mov %40,c
    anl _driver_bus_f9,#0xfe
    nop
} by {
    orl _driver_bus_f9,#0x01
    mov c,%40
    mov a,_driver_bus_f9
    mov _ACC_DATA_OUT,c
    mov _driver_bus_f9,a
    mov c,_ACC_DATA_IN
    mov %40,c
    anl _driver_bus_f9,#0xfe
    nop
}

// Store the shift response from B without changing the stock access order.
replace {
    mov dptr,#_relay_driver_response
    mov a,_B
    movx @dptr,a
    %1:
    ret
} by {
    mov a,_B
    mov dptr,#_relay_driver_response
    movx @dptr,a
    ret
}
