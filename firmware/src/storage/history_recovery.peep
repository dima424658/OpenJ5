    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
    mov a,_stock_r1
    dec a
    mov r7,a
    mov _stock_r1,r7
    mov a,r7
    jz %5
    ljmp %1
    %5:
    %4:
