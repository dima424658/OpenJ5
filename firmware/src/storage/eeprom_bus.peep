// Keep the transmit byte and loop counters in the stock registers.
replace {
    mov _ACC,_stock_r4
    mov _stock_r2,#0x08
    %1:
    mov c,_CARRY
    clr a
    rlc a
    mov r7,a
    mov c,_ACC_SIGN
    mov _CARRY,c
    mov a,_ACC
    add a,acc
    mov r6,a
    mov a,r7
    orl a,r6
    mov _ACC,a
    mov c,_CARRY
    mov _eeprom_sda,c
    nop
    nop
    nop
    nop
    setb _eeprom_scl
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    clr _eeprom_scl
    mov a,_stock_r2
    dec a
    mov r7,a
    mov _stock_r2,r7
    mov a,r7
    jz %2
    ljmp %1
    %2:
    nop
    nop
    setb _eeprom_sda
    nop
    nop
    nop
    nop
    setb _eeprom_scl
    nop
    nop
    nop
    nop
    orl _sfr_b9,#0x80
    orl _P1,#0x20
    nop
    mov c,_eeprom_sda
    mov _CARRY,c
    nop
    nop
    nop
    nop
    nop
    clr _eeprom_scl
    nop
    nop
    nop
    orl _sfr_b9,#0x80
    anl _P1,#0xdf
    %3:
    ret
} by {
    mov a,r4
    mov r2,#0x08
    00970$:
    rlc a
    mov _eeprom_sda,c
    nop
    nop
    nop
    nop
    setb _eeprom_scl
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    clr _eeprom_scl
    djnz r2,00970$
    nop
    nop
    setb _eeprom_sda
    nop
    nop
    nop
    nop
    setb _eeprom_scl
    nop
    nop
    nop
    nop
    orl _sfr_b9,#0x80
    orl _P1,#0x20
    nop
    mov c,_eeprom_sda
    nop
    nop
    nop
    nop
    nop
    clr _eeprom_scl
    nop
    nop
    nop
    orl _sfr_b9,#0x80
    anl _P1,#0xdf
    ret
}

