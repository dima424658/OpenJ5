// Read the first EEPROM page with a repeated start.
replace {
    mov _sfr_86,#0x80
    setb _iac_tick_enabled
    setb _iac_tick_high_priority
    mov _stock_r3,_stock_r4
    lcall _eeprom_bus_start
    mov _stock_r4,#0xa0
    lcall _eeprom_bus_send_byte
    jnb _CARRY,%1
    ljmp %2
    %1:
    mov _stock_r4,_stock_r3
    lcall _eeprom_bus_send_byte
    jnb _CARRY,%3
    ljmp %2
    %3:
    lcall _eeprom_bus_start
    mov _stock_r4,#0xa1
    lcall _eeprom_bus_send_byte
    jnb _CARRY,%4
    ljmp %2
    %4:
    %5:
    mov a,#0x01
    cjne a,_stock_r1,%6
    setb c
    sjmp %7
    %6:
    clr c
    %7:
    mov _CARRY,c
    lcall _eeprom_bus_receive_byte
    mov r1,_stock_r0
    mov @r1,_stock_r4
    inc _stock_r0
    mov a,_stock_r1
    dec a
    mov r7,a
    mov _stock_r1,r7
    mov a,r7
    jz %8
    ljmp %5
    %8:
    lcall _eeprom_bus_stop
    clr _CARRY
    ljmp %9
    %2:
    setb _CARRY
    %9:
    ret
} by {
    mov _sfr_86,#0x80
    setb _iac_tick_enabled
    setb _iac_tick_high_priority
    mov 0x03,r4
    lcall _eeprom_bus_start
    mov r4,#0xa0
    lcall _eeprom_bus_send_byte
    jc 00970$
    mov r4,0x03
    lcall _eeprom_bus_send_byte
    jc 00970$
    lcall _eeprom_bus_start
    mov r4,#0xa1
    lcall _eeprom_bus_send_byte
    jc 00970$
    00973$:
    mov a,r1
    dec a
    jnz 00971$
    setb c
    sjmp 00972$
    00971$:
    clr c
    00972$:
    lcall _eeprom_bus_receive_byte
    mov a,r4
    mov @r0,a
    inc r0
    djnz r1,00973$
    lcall _eeprom_bus_stop
    clr c
    sjmp 00974$
    00970$:
    setb c
    00974$:
    ret
}

