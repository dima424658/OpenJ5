    mov _TL2,a
    mov _TH2,a
}

// Check the service-save marker and fall through to retained-RAM validation after serial setup.
replace {
    mov a,_sfr_a9
    jb acc.6,%1
    ljmp %2
    %1:
    mov dptr,#_service_save_marker
    movx a,@dptr
    mov r7,a
    cjne r7,#0x55,%3
    ljmp %2
    %3:
    setb _reset_adaptive_state
    %2:
    mov _sfr_b9,#0x28
    mov _sfr_a9,#0x30
    lcall _initialize_serial_interface
    lcall _check_startup_ram
    %4:
    ret
} by {
    mov a,_sfr_a9
    anl a,#0x40
    jz 00972$
    mov dptr,#_service_save_marker
    movx a,@dptr
    xrl a,#0x55
    jz 00972$
    setb _reset_adaptive_state
    00972$:
    mov _sfr_b9,#0x28
    mov _sfr_a9,#0x30
    lcall _initialize_serial_interface
}
