// Clear the marker and test the five ADC windows in order.
replace {
    mov r1,_stock_r0
    mov @r1,#0x00
    mov _alternate_startup_marker,#0x00
    mov _B,#0x00
    lcall _read_adc_8bit
    mov _stock_r0,_ACC
    clr c
    mov a,_stock_r0
    subb a,#0xdd
    jnc %1
    ljmp %2
    %1:
    clr c
    mov a,_stock_r0
    subb a,#0xe8
    jc %3
    ljmp %2
    %3:
    mov _B,#0x0d
    lcall _read_adc_8bit
    mov _stock_r0,_ACC
    clr c
    mov a,_stock_r0
    subb a,#0xf5
    jnc %4
    ljmp %2
    %4:
    clr c
    mov a,_stock_r0
    subb a,#0xfe
    jc %5
    ljmp %2
    %5:
    mov _B,#0x04
    lcall _read_adc_8bit
    mov _stock_r0,_ACC
    clr c
    mov a,_stock_r0
    subb a,#0xf5
    jnc %6
    ljmp %2
    %6:
    clr c
    mov a,_stock_r0
    subb a,#0xfe
    jc %7
    ljmp %2
    %7:
    mov _B,#0x03
    lcall _read_adc_8bit
    mov _stock_r0,_ACC
    clr c
    mov a,_stock_r0
    subb a,#0x15
    jnc %8
    ljmp %2
    %8:
    clr c
    mov a,_stock_r0
    subb a,#0x1e
    jc %9
    ljmp %2
    %9:
    mov _B,#0x0b
    lcall _read_adc_8bit
    mov _stock_r0,_ACC
    clr c
    mov a,_stock_r0
    subb a,#0xf5
    jnc %10
    ljmp %2
    %10:
    clr c
    mov a,_stock_r0
    subb a,#0xfe
    jnc %11
    ljmp %12
    %11:
    %2:
    lcall _read_eeprom_record_f485
    lcall _read_eeprom_record_f48d
    lcall _read_eeprom_record_f495
    lcall _read_eeprom_record_f460
    lcall _read_eeprom_record_f474
    lcall _read_eeprom_record_f480
    lcall _check_eeprom_record_9d
    mov a,#0x55
    cjne a,_stock_r5,%13
    sjmp %14
    %13:
    ljmp %15
    %14:
    mov dptr,#_retained_status
    movx a,@dptr
    jb acc.1,%16
    ljmp %17
    %16:
    %15:
    lcall _restore_startup_eeprom_bd12
    %17:
    lcall _restore_immobilizer_records
    lcall _restart_runtime_init
    ljmp %18
    %12:
    mov _alternate_startup_marker,#0x55
    lcall _enter_alternate_startup
    %18:
    ret
} by {
    clr a
    mov @r0,a
    mov _alternate_startup_marker,a
    mov _B,#0x00
    lcall _read_adc_8bit
    mov r0,a
    clr c
    subb a,#0xdd
    jc 00970$
    mov a,r0
    clr c
    subb a,#0xe8
    jnc 00970$
    mov _B,#0x0d
    lcall _read_adc_8bit
    mov r0,a
    clr c
    subb a,#0xf5
    jc 00970$
    mov a,r0
    clr c
    subb a,#0xfe
    jnc 00970$
    mov _B,#0x04
    lcall _read_adc_8bit
    mov r0,a
    clr c
    subb a,#0xf5
    jc 00970$
    mov a,r0
    clr c
    subb a,#0xfe
    jnc 00970$
    mov _B,#0x03
    lcall _read_adc_8bit
    mov r0,a
    clr c
    subb a,#0x15
    jc 00970$
    mov a,r0
    clr c
    subb a,#0x1e
    jnc 00970$
    mov _B,#0x0b
    lcall _read_adc_8bit
    mov r0,a
    clr c
    subb a,#0xf5
    jc 00970$
    mov a,r0
    clr c
    subb a,#0xfe
    jnc 00970$
    mov _alternate_startup_marker,#0x55
    ljmp _enter_alternate_startup
    00970$:
    lcall _read_eeprom_record_f485
    lcall _read_eeprom_record_f48d
    lcall _read_eeprom_record_f495
    lcall _read_eeprom_record_f460
    lcall _read_eeprom_record_f474
    lcall _read_eeprom_record_f480
    lcall _check_eeprom_record_9d
    mov a,r5
    xrl a,#0x55
    jnz 00971$
    mov dptr,#_retained_status
    movx a,@dptr
    jnb acc.1,00972$
    00971$:
    lcall _restore_startup_eeprom_bd12
    00972$:
    lcall _restore_immobilizer_records
}

// Keep the indirect RAM clear loops in R0.
replace {
    mov _stock_r0,#0x2c
    %1:
    mov r1,_stock_r0
    mov @r1,#0x00
    mov a,_stock_r0
    dec a
    mov r7,a
    mov _stock_r0,r7
    mov a,r7
    jz %2
    ljmp %1
    %2:
    mov _stock_r0,#0x2e
    %3:
    mov r1,_stock_r0
    mov @r1,#0x00
    mov a,_stock_r0
    inc a
    mov r7,a
    mov _stock_r0,r7
    mov a,r7
    jz %4
    ljmp %3
    %4:
} by {
    mov r0,#0x2c
    00970$:
    mov @r0,#0x00
    djnz r0,00970$
    mov r0,#0x2e
    00971$:
    mov @r0,#0x00
    inc r0
    mov a,r0
    jnz 00971$
}

