    mov _SCON,#0x00
    mov _TCON,#0x00
    mov _TL0,#0x00
    mov _TH0,#0x00
    mov _TL1,#0x00
    mov _TH1,#0x00
    mov _TL2,#0x00
    mov _TH2,#0x00
} by {
    clr a
    mov _sfr_d8,a
    mov _sfr_dc,a
    mov _sfr_da,a
    mov _sfr_d9,a
