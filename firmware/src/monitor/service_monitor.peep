// Use the stock register pair and let DPTR wrap after all 65536 bytes.
replace {
    mov a,#0x00
    mov _stock_r01,a
    mov (_stock_r01 + 1),a
    mov ar6,a
    mov ar7,a
    %1:
    mov dpl,r6
    mov dph,r7
    clr a
    movc a,@a+dptr
    mov r5,a
    mov r4,#0x00
    mov r2,_stock_r01
    mov r3,(_stock_r01 + 1)
    mov a,r5
    add a, r2
    mov r2,a
    mov a,r4
    addc a, r3
    mov r3,a
    mov _stock_r01,r2
    mov (_stock_r01 + 1),r3
    inc r6
    cjne r6,#0x00,%2
    inc r7
    %2:
    setb _iac_tick_interrupt_enabled
    setb _iac_tick_high_priority
    mov a,r6
    orl a,r7
    jz %3
    ljmp %1
    %3:
} by {
    mov r0,#0x00
    mov r1,#0x00
    mov dptr,#0x0000
    %1:
    clr a
    movc a,@a+dptr
    inc dptr
    add a,r0
    mov r0,a
    clr a
    addc a,r1
    mov r1,a
    setb _iac_tick_interrupt_enabled
    setb _iac_tick_high_priority
    mov a,dph
    cjne a,#0x00,%1
    mov a,dpl
    jnz %1
}

// Preserve the split subtraction and tail jump to publish the monitor result.
replace {
    mov dptr,#_flash_checksum_expected
    clr a
    movc a,@a+dptr
    mov r6,a
    mov a,#0x01
    movc a,@a+dptr
    mov r7,a
    mov a,r6
    clr c
    subb a,_stock_r01
    mov r6,a
    mov a,r7
    subb a,(_stock_r01 + 1)
    mov r7,a
    mov _monitor_checksum_difference,r6
    mov (_monitor_checksum_difference + 1),r7
    mov a,r6
    orl a,r7
    jnz %1
    ljmp %2
    %1:
    setb _monitor_checksum_failed
    %2:
    clr _monitor_command_active
    setb _monitor_result_ready
    lcall _resume_service_monitor
    %3:
    ret
} by {
    mov dptr,#_flash_checksum_expected
    clr a
    movc a,@a+dptr
    clr c
    subb a,r0
    mov r0,a
    inc dptr
    clr a
    movc a,@a+dptr
    subb a,r1
    mov _monitor_checksum_difference,r0
    mov (_monitor_checksum_difference + 1),a
    orl a,r0
    jz %2
    setb _monitor_checksum_failed
    %2:
    clr _monitor_command_active
    setb _monitor_result_ready
    ljmp _resume_service_monitor
}

// Keep the exact timing of the stock delay loop and three carry complements.
replace {
    %1:
    mov a,#0x00
    mov _stock_r01,a
    mov (_stock_r01 + 1),a
    %2:
    mov a,#0x01
    add a, _stock_r01
    mov _stock_r01,a
    mov a,#0x00
    addc a, (_stock_r01 + 1)
    mov (_stock_r01 + 1),a
    mov r6,_stock_r01
    mov r7,(_stock_r01 + 1)
    cjne r6,#0xe8,%3
    cjne r7,#0x03,%3
    sjmp %4
    %3:
    ljmp %2
    %4:
    lcall _poll_monitor_exit
    cpl _monitor_output_ed
    ljmp %1
    %5:
    ret
} by {
    %1:
    mov r0,#0x00
    mov r1,#0x00
    %2:
    inc r0
    mov a,r0
    jnz 00970$
    inc r1
    00970$:
    mov a,r0
    cjne a,#0xe8,%2
    mov a,r1
    cjne a,#0x03,%2
    lcall _poll_monitor_exit
    mov c,_monitor_output_ed
    cpl c
    cpl c
    cpl c
    mov _monitor_output_ed,c
    sjmp %1
}
