// Keep the opcode in A, and keep invalid-length exits in the caller.
replace {
    mov a,#%1
    cjne a,_ACC,%2
    sjmp %3
    %2:
    ljmp %4
    %3:
} by {
    cjne a,#%1,%4
}

replace {
    mov a,_stock_r3
    jz %1
    ljmp %2
    %1:
} by {
    mov a,r3
    cjne a,#0x00,_reject_monitor_frame
}

replace {
    mov a,#%1
    cjne a,_stock_r3,%2
    sjmp %3
    %2:
    ljmp %4
    %3:
} by {
    mov a,r3
    cjne a,#%1,_reject_monitor_frame
}

// Equality in CJNE already clears CY. The write branches set it explicitly.
replace {
    clr _CARRY
    ljmp %1
} by {
    sjmp %1
}

replace {
    setb _CARRY
} by {
    setb c
}

replace {
    mov _ACC,#0x09
    ljmp %1
} by {
    mov a,#0x09
    sjmp %1
}

replace {
    mov _stock_r1,%1
} by {
    mov r1,%1
}

replace {
    mov r1,#0x01
    ljmp %1
} by {
    mov r1,#0x01
    sjmp %1
}

replace {
    mov a,#0x16
    cjne a,_ACC,%1
    ljmp %2
    %1:
    lcall _dispatch_monitor_extended_frame
    ljmp %3
    %2:
} by {
    cjne a,#0x16,_dispatch_monitor_extended_frame
}

// Increment the active DPTR without changing CY or copying its bytes.
replace {
    mov a,#0x01
    add a, ((_STOCK_DPTR >> 0) & 0xFF)
    mov ((_STOCK_DPTR >> 0) & 0xFF),a
    mov a,#0x00
    addc a, ((_STOCK_DPTR >> 8) & 0xFF)
    mov ((_STOCK_DPTR >> 8) & 0xFF),a
} by {
    inc dptr
}

replace {
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    movx a,@dptr
} by {
    movx a,@dptr
}

replace {
    mov _stock_r0,a
} by {
    mov r0,a
}

replace {
    jb _CARRY,%1
    ljmp %2
    %1:
} by {
    jnc %2
}

replace {
    mov _ACC,a
    mov r1,_stock_r0
    mov @r1,_ACC
} by {
    mov @r0,a
}

replace {
    mov r1,_stock_r0
    mov _B,@r1
    mov _ACC,_stock_r0
    ljmp %1
} by {
    mov _B,@r0
    .globl _append_monitor_reg_result
    _append_monitor_reg_result = .
    mov a,r0
    sjmp %1
}

replace {
    movx a,@dptr
    mov _ACC,a
} by {
    movx a,@dptr
}

replace {
    mov _DPH,_stock_r0
} by {
    mov _DPH,r0
}

replace {
    mov dpl,((_STOCK_DPTR >> 0) & 0xFF)
    mov dph,((_STOCK_DPTR >> 8) & 0xFF)
    mov a,_ACC
    movx @dptr,a
} by {
    movx @dptr,a
}

replace {
    mov _B,_ACC
} by {
    mov _B,a
}

replace {
    mov _ACC,%1
} by {
    mov a,%1
}

replace {
    %3:
    lcall _append_monitor_reply_byte
    lcall _start_monitor_reply
    ljmp %1
    %2:
    lcall _reject_monitor_frame
    %1:
    ret
} by {
    %3:
    .globl _append_monitor_result
    _append_monitor_result = .
    lcall _append_monitor_reply_byte
    ljmp _start_monitor_reply
}
