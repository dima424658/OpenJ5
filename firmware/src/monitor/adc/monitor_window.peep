// Select the ADC window channel and preserve the first P9 command.
replace {
    mov r6,#_monitor_window_adc_channels
    mov r7,#(_monitor_window_adc_channels >> 8)
    mov ((_STOCK_DPTR >> 0) & 0xFF),r6
    mov ((_STOCK_DPTR >> 8) & 0xFF),r7
    lcall _select_monitor_adc_channel
    mov _ACC,#0x2c
    anl _P9,#0xdf
    mov _B,#0x08
    %1:
    mov c,_CY
    clr a
    rlc a
    mov r7,a
    mov c,_ACC_SIGN
    mov _CY,c
    mov a,_ACC
    add a,acc
    mov r6,a
    mov a,r7
    orl a,r6
    mov _ACC,a
    jb _CY,%2
    ljmp %3
    %2:
    orl _P9,#0x80
    ljmp %4
    %3:
    anl _P9,#0x7f
    %4:
    anl _P9,#0xef
    orl _P9,#0x10
    mov a,_B
    dec a
    mov r7,a
    mov _B,r7
    mov a,r7
    jz %5
    ljmp %1
    %5:
    mov c,_CY
    clr a
    rlc a
    mov r7,a
    mov c,_ACC_SIGN
    mov _CY,c
    mov a,_ACC
    add a,acc
    mov r6,a
    mov a,r7
    orl a,r6
    mov _ACC,a
    orl _P9,#0x20
} by {
    mov dptr,#0xe7bc
    lcall _select_monitor_adc_channel
    mov a,#0x2c
    anl a,#0x3f
    orl a,#0x00
    anl _P9,#0xdf
    mov _B,#0x08
    00972$:
    rlc a
    jnc 00970$
    orl _P9,#0x80
    sjmp 00971$
    00970$:
    anl _P9,#0x7f
    00971$:
    anl _P9,#0xef
    orl _P9,#0x10
    djnz _B,00972$
    rlc a
    orl _P9,#0x20
}

